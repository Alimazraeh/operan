{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.operan.io/v1/module05.json",
  "title": "Operan Module 05 — Department Template Engine Schemas",
  "description": "Comprehensive JSON Schema definitions for the Department Template Engine domain objects.",
  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Human-readable identifier used by template-embedded definitions (e.g., 'it-mgr-01')."
    },
    "semver": {
      "type": "string",
      "description": "Semantic versioning string (e.g., '1.2.3').",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date-time": {
      "type": "string",
      "format": "date-time"
    },
    "templateCategory": {
      "type": "string",
      "enum": ["hr", "finance", "procurement", "engineering", "translation", "legal", "compliance", "research", "marketing", "software-development", "it", "it-operations", "ops", "sales", "support", "custom"]
    },
    "roleType": {
      "type": "string",
      "enum": ["director", "manager", "specialist", "coordinator", "analyst", "support"],
      "description": "Agent Role Taxonomy from the GARDEN framework."
    },
    "holderType": {
      "type": "string",
      "enum": ["ai_agent", "human", "vacant"]
    },
    "autonomyTier": {
      "type": "string",
      "enum": ["recommend", "analyze", "coordinate", "draft", "execute"],
      "description": "Autonomy ladder aligned with Module 04 CapabilityTier."
    },
    "decisionAuthority": {
      "type": "string",
      "enum": ["decide", "recommend", "veto", "must_be_informed"]
    },
    "riskSeverity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "riskLikelihood": {
      "type": "string",
      "enum": ["rare", "unlikely", "possible", "likely", "almost_certain"]
    },
    "riskStatus": {
      "type": "string",
      "enum": ["open", "mitigating", "accepted", "closed"]
    },
    "departmentStatus": {
      "type": "string",
      "enum": ["provisioning", "operational", "degraded", "suspended", "archived"]
    },
    "opScope": {
      "type": "string",
      "enum": ["department", "agent", "service"]
    },
    "agentStatus": {
      "type": "string",
      "enum": ["draft", "deprecated", "published", "archived"]
    },
    "workflowStepType": {
      "type": "string",
      "enum": ["agent_call", "api_call", "data_fetch", "transformation", "approval", "notification", "tool_call", "conditional"]
    },
    "governanceRuleType": {
      "type": "string",
      "enum": ["access_control", "data_usage", "rate_limit", "audit", "compliance", "custom"]
    },
    "governanceEnforcement": {
      "type": "string",
      "enum": ["enforce", "warn", "log"]
    },
    "kpiMetricType": {
      "type": "string",
      "enum": ["counter", "gauge", "histogram", "timer", "boolean"]
    },
    "kpiAggregationPeriod": {
      "type": "string",
      "enum": ["minute", "hour", "day", "week", "month"]
    },
    "integrationType": {
      "type": "string",
      "enum": ["erp", "crm", "email", "calendar", "document", "messaging", "custom"]
    },
    "integrationAuthMethod": {
      "type": "string",
      "enum": ["oauth2", "api_key", "basic", "jwt", "custom"]
    },
    "integrationStatus": {
      "type": "string",
      "enum": ["active", "inactive", "error", "pending"]
    },
    "policyScope": {
      "type": "string",
      "enum": ["agent", "workflow", "department", "system"]
    },
    "deploymentEnvironment": {
      "type": "string",
      "enum": ["dev", "staging", "production"]
    },
    "deploymentStatus": {
      "type": "string",
      "enum": ["select", "configure", "connect_data", "provision_memory", "deploy_swarm", "operational", "failed", "rolled_back"]
    },

    "AgentDefinition": {
      "type": "object",
      "required": ["id", "role", "capabilities"],
      "description": "Canonical template agent definition. Superset of the historical formal and divergent shapes.",
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "role": {
          "type": "string",
          "description": "Agent role within the department (e.g., 'analyst', 'coordinator')."
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": { "type": "string" },
        "level": {
          "type": "string",
          "enum": ["junior", "mid", "senior", "lead", "director"]
        },
        "position_title": { "type": "string", "maxLength": 200 },
        "reports_to": {
          "$ref": "#/definitions/slug",
          "description": "AgentDefinition.id of the direct superior (chain of command)."
        },
        "autonomy_tier": { "$ref": "#/definitions/autonomyTier" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "model": { "type": "string" },
        "system_prompt": { "type": "string" },
        "memory_profile": { "type": "string" },
        "tool_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "access_control": {
          "type": "object"
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" },
          "description": "ServiceOffering.ids this agent owns/delivers."
        },
        "decision_rights": {
          "type": "array",
          "items": { "$ref": "#/definitions/DecisionRight" }
        },
        "escalation_path": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered AgentDefinition.ids ending with 'human' for M09 gates."
        },
        "schedule": {
          "type": "object",
          "additionalProperties": true,
          "description": "Availability/shift info (e.g., {\"availability\": \"24x7\"})."
        },
        "risk_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "quality_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "compliance_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "created_at": { "$ref": "#/definitions/date-time" },
        "updated_at": { "$ref": "#/definitions/date-time" }
      },
      "additionalProperties": false
    },

    "DecisionRight": {
      "type": "object",
      "required": ["decision", "authority"],
      "properties": {
        "decision": { "type": "string" },
        "authority": { "$ref": "#/definitions/decisionAuthority" },
        "limit": {
          "type": "string",
          "description": "Bound on the authority (e.g., '$500', 'low-risk changes only')."
        }
      },
      "additionalProperties": false
    },

    "CadenceEntry": {
      "type": "object",
      "required": ["name", "frequency"],
      "properties": {
        "name": { "type": "string" },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "quarterly", "annually", "on_demand"]
        },
        "description": { "type": "string" },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" },
          "description": "Position.ids attending this ritual."
        }
      },
      "additionalProperties": false
    },

    "BusinessLogic": {
      "type": "object",
      "required": ["purpose"],
      "properties": {
        "purpose": { "type": "string", "description": "Why the department exists." },
        "value_proposition": { "type": "string", "description": "The business 'so what'." },
        "activities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stakeholders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "operating_cadence": {
          "type": "array",
          "items": { "$ref": "#/definitions/CadenceEntry" }
        }
      },
      "additionalProperties": false
    },

    "Position": {
      "type": "object",
      "required": ["id", "title", "role_type", "holder_type"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "title": { "type": "string", "maxLength": 200 },
        "role_type": { "$ref": "#/definitions/roleType" },
        "holder_type": { "$ref": "#/definitions/holderType" },
        "agent_def_id": {
          "$ref": "#/definitions/slug",
          "description": "Template agents[].id filling this position (blueprint link)."
        },
        "agent_id": {
          "type": "string",
          "description": "Provisioned Module 04 agent id (instance only; filled by deploy)."
        },
        "human_ref": {
          "type": "string",
          "description": "Email/user id when holder_type is human."
        },
        "reports_to": {
          "$ref": "#/definitions/slug",
          "description": "Position.id of the direct superior; absent for the root position."
        },
        "unit": {
          "type": "string",
          "description": "Sub-team grouping (e.g., 'Service Desk', 'Infrastructure')."
        },
        "autonomy_tier": { "$ref": "#/definitions/autonomyTier" },
        "decision_rights": {
          "type": "array",
          "items": { "$ref": "#/definitions/DecisionRight" }
        },
        "escalates_to": {
          "$ref": "#/definitions/slug",
          "description": "Position.id escalation target; terminal positions escalate to human via Module 09."
        },
        "approval_gate_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Module 09 threshold-rule/gate identifiers."
        }
      },
      "additionalProperties": false
    },

    "SLA": {
      "type": "object",
      "properties": {
        "availability": { "type": "string", "description": "e.g., '99.9%'" },
        "response_time": { "type": "string", "description": "e.g., '15m (P1) / 4h (P3)'" },
        "resolution_time": { "type": "string", "description": "e.g., '4h (P1) / 2d (P3)'" },
        "coverage": { "type": "string", "description": "e.g., '24x7', 'business-hours'" }
      },
      "additionalProperties": false
    },

    "ServiceOffering": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "owner_position_id": { "$ref": "#/definitions/slug" },
        "owner_agent_def_id": { "$ref": "#/definitions/slug" },
        "consumers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Departments/roles served (e.g., 'all-employees', 'hr')."
        },
        "sla": { "$ref": "#/definitions/SLA" },
        "delivery_workflow_id": {
          "$ref": "#/definitions/slug",
          "description": "WorkflowDefinition.id that delivers this service."
        },
        "kpi_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" },
          "description": "KPIDefinition.ids measuring this service."
        },
        "request_channel": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "planned", "retired"]
        }
      },
      "additionalProperties": false
    },

    "ValueStage": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "activities": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "owner_position_id": { "$ref": "#/definitions/slug" },
        "workflow_ref": { "$ref": "#/definitions/slug" }
      },
      "additionalProperties": false
    },

    "ValueStream": {
      "type": "object",
      "required": ["id", "name", "stages"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/ValueStage" }
        },
        "outcome": { "type": "string", "description": "Measurable end state." },
        "business_outcome": { "type": "string", "description": "The business 'so what'." },
        "value_metric_kpi_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" },
          "description": "KPI ids that prove value realization."
        }
      },
      "additionalProperties": false
    },

    "RiskItem": {
      "type": "object",
      "required": ["id", "name", "severity", "likelihood"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["operational", "security", "compliance", "financial", "model"]
        },
        "severity": { "$ref": "#/definitions/riskSeverity" },
        "likelihood": { "$ref": "#/definitions/riskLikelihood" },
        "mitigation": { "type": "string" },
        "owner_position_id": { "$ref": "#/definitions/slug" },
        "scope": { "$ref": "#/definitions/opScope" },
        "agent_def_id": { "$ref": "#/definitions/slug" },
        "service_ref": { "$ref": "#/definitions/slug" },
        "status": { "$ref": "#/definitions/riskStatus" },
        "review_cadence": { "type": "string" }
      },
      "additionalProperties": false
    },

    "QualityStandard": {
      "type": "object",
      "required": ["id", "name", "target"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["slo", "sla_internal", "review_gate", "accuracy_target"]
        },
        "target": { "type": "string", "description": "e.g., '99.9% uptime', '>=90% CSAT'" },
        "measure_kpi_ref": { "$ref": "#/definitions/slug" },
        "scope": { "$ref": "#/definitions/opScope" },
        "service_ref": { "$ref": "#/definitions/slug" },
        "agent_def_id": { "$ref": "#/definitions/slug" },
        "enforced_by": {
          "type": "string",
          "description": "GovernanceRule.id or Module 09 gate reference."
        }
      },
      "additionalProperties": false
    },

    "ComplianceControl": {
      "type": "object",
      "required": ["id", "framework", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "framework": {
          "type": "string",
          "description": "e.g., 'ITIL-v4', 'ISO-27001', 'SOC2', 'NIST-CSF', 'GDPR', 'custom'."
        },
        "control_id": {
          "type": "string",
          "description": "Framework-native control identifier (e.g., 'A.9.2', 'PR.AC-1')."
        },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string" },
        "applies_to": { "$ref": "#/definitions/opScope" },
        "agent_def_ids": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "governance_rule_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" },
          "description": "Existing GovernanceRule.ids implementing this control."
        },
        "policy_ref": {
          "type": "string",
          "description": "Module 10 policy id (optional)."
        },
        "evidence_kpi_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/slug" }
        },
        "status": {
          "type": "string",
          "enum": ["implemented", "planned", "not_applicable"]
        }
      },
      "additionalProperties": false
    },

    "StageRecord": {
      "type": "object",
      "required": ["stage", "status"],
      "properties": {
        "stage": { "$ref": "#/definitions/deploymentStatus" },
        "status": {
          "type": "string",
          "enum": ["running", "completed", "failed"]
        },
        "detail": { "type": "string" },
        "started_at": { "$ref": "#/definitions/date-time" },
        "completed_at": { "$ref": "#/definitions/date-time" }
      },
      "additionalProperties": false
    },

    "Department": {
      "type": "object",
      "required": ["id", "tenant_id", "name", "category", "status"],
      "description": "A deployed, living department instance materialized from a Template blueprint.",
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "tenant_id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "$ref": "#/definitions/slug" },
        "category": { "$ref": "#/definitions/templateCategory" },
        "description": { "type": "string" },
        "template_id": { "$ref": "#/definitions/uuid" },
        "template_version": { "$ref": "#/definitions/semver" },
        "deployment_id": { "$ref": "#/definitions/uuid" },
        "status": { "$ref": "#/definitions/departmentStatus" },
        "mission": { "type": "string" },
        "business_logic": { "$ref": "#/definitions/BusinessLogic" },
        "org_chart": {
          "type": "array",
          "items": { "$ref": "#/definitions/Position" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/definitions/ServiceOffering" }
        },
        "value_streams": {
          "type": "array",
          "items": { "$ref": "#/definitions/ValueStream" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/definitions/RiskItem" }
        },
        "quality_standards": {
          "type": "array",
          "items": { "$ref": "#/definitions/QualityStandard" }
        },
        "compliance_controls": {
          "type": "array",
          "items": { "$ref": "#/definitions/ComplianceControl" }
        },
        "governance_rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/GovernanceRule" }
        },
        "kpis": {
          "type": "array",
          "items": { "$ref": "#/definitions/KPIDefinition" }
        },
        "operational_policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/OperationalPolicy" }
        },
        "agent_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Provisioned Module 04 agent ids."
        },
        "workflow_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memory_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Module 07 document ids."
        },
        "environment": { "$ref": "#/definitions/deploymentEnvironment" },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "$ref": "#/definitions/date-time" },
        "updated_at": { "$ref": "#/definitions/date-time" },
        "created_by": { "type": "string" }
      },
      "additionalProperties": false
    },

    "WorkflowStep": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "type": { "$ref": "#/definitions/workflowStepType" },
        "name": { "type": "string" },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "timeout_seconds": { "type": "integer" },
        "retry_policy": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "WorkflowDefinition": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowStep" }
        },
        "triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error_handling": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "$ref": "#/definitions/date-time" },
        "updated_at": { "$ref": "#/definitions/date-time" }
      },
      "additionalProperties": false
    },

    "MemoryTopology": {
      "type": "object",
      "properties": {
        "semantic_enabled": {
          "type": "boolean",
          "default": true
        },
        "episodic_enabled": {
          "type": "boolean",
          "default": true
        },
        "procedural_enabled": {
          "type": "boolean",
          "default": true
        },
        "graph_enabled": {
          "type": "boolean",
          "default": true
        },
        "memory_profiles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "compression_settings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },

    "GovernanceRule": {
      "type": "object",
      "required": ["id", "name", "type", "enforcement"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "type": { "$ref": "#/definitions/governanceRuleType" },
        "description": { "type": "string" },
        "enforcement": { "$ref": "#/definitions/governanceEnforcement" },
        "conditions": {
          "type": "object",
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_at": { "$ref": "#/definitions/date-time" },
        "updated_at": { "$ref": "#/definitions/date-time" }
      },
      "additionalProperties": false
    },

    "KPIDefinition": {
      "type": "object",
      "required": ["id", "name", "metric_type"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": { "type": "string" },
        "metric_type": { "$ref": "#/definitions/kpiMetricType" },
        "unit": { "type": "string" },
        "thresholds": {
          "type": "object",
          "properties": {
            "warning": { "type": "number" },
            "critical": { "type": "number" }
          }
        },
        "aggregation_period": { "$ref": "#/definitions/kpiAggregationPeriod" },
        "dashboard_link": {
          "type": "string",
          "format": "uri"
        },
        "created_at": { "$ref": "#/definitions/date-time" },
        "updated_at": { "$ref": "#/definitions/date-time" }
      },
      "additionalProperties": false
    },

    "IntegrationDefinition": {
      "type": "object",
      "required": ["id", "type", "config"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "type": { "$ref": "#/definitions/integrationType" },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "provider": { "type": "string" },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Provider-specific connection configuration."
        },
        "auth_method": { "$ref": "#/definitions/integrationAuthMethod" },
        "status": { "$ref": "#/definitions/integrationStatus" },
        "created_at": { "$ref": "#/definitions/date-time" },
