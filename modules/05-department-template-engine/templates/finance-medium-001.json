      "role": "Financial Analyst",
      "capabilities": [
        "budget-forecasting",
        "variance-analysis",
        "financial-modeling",
        "kpi-tracking",
        "business-case-analysis",
        "pricing-analysis",
        "investment-analysis",
        "scenario-planning",
        "executive-presentations"
      ],
      "model": "qwen-72b",
      "memory_profile": "semantic-enabled, procedural-enabled",
      "tool_requirements": ["erp-system", "analytics-dashboard", "excel-api", "email", "document-storage", "bi-tool"],
      "system_prompt": "You are a Financial Analyst supporting strategic decision-making for a medium enterprise. You build financial models, conduct variance analysis, prepare forecasts, track KPIs, and develop business cases for management. You translate complex financial data into actionable insights for the Finance Manager and executive team. You maintain rolling forecasts and scenario analyses.",
      "constraints": {
        "max_tokens_per_request": 8192,
        "modeling_data": "version-controlled"
