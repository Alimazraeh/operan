{
  "id": "finance-medium-001",
  "name": "Medium Enterprise Finance Department",
  "description": "5–15 person finance department for mid-market companies (50–500 employees). Specialized roles: Finance Manager, Senior Accountant, Junior Accountant, AP/AR Clerks, Financial Analyst, and GPO. Formal SOPs, segregation of duties, monthly close process, budgeting & forecasting, audit preparation. Frameworks: GAAP, SOX (if applicable).",
  "category": "finance",
  "version": "1.0.0",
  "metadata": {
    "enterprise_size": "medium",
    "department_size": "5-15 FTE",
    "company_size": "50-500 employees",
    "industry": "general",
    "compliance_level": "formalized",
    "frameworks": ["GAAP", "SOX", "NetSuite", "SAP", "QuickBooks"],
    "last_reviewed": "2026-07-17"
  },
  "tags": ["finance", "medium-enterprise", "specialized", "mid-market", "sox", "audit-ready", "formalized"],
  "status": "published",
  "created_by": "platform",
  "agents": [
    {
      "id": "finance-manager-01",
      "role": "Finance Manager / Director",
      "capabilities": [
        "financial-strategy",
        "budgeting-and-forecasting",
        "financial-reporting",
        "audit-management",
        "treasury-management",
        "investor-relations",
        "tax-strategy",
        "risk-management",
        "system-implementation",
        "team-leadership"
      ],
      "model": "qwen-72b",
      "memory_profile": "episodic-enabled, graph-enabled, full-retention",
      "tool_requirements": ["erp-system", "analytics-dashboard", "email", "document-storage", "payroll-api", "bank-api", "board-reporting"],
      "system_prompt": "You are the Finance Manager/Director for a medium enterprise. You lead a team of 10+ finance specialists across accounting, analysis, AP/AR, and payroll. You report to the CFO or department head. You own the financial close process, budgeting, forecasting, and external audit relationship. You ensure compliance with GAAP and SOX (if applicable). You maintain the highest standards of financial integrity and regulatory compliance.",
      "constraints": {
        "max_tokens_per_request": 16384,
        "rate_limit": 500,
        "pii_handling": "encrypted-at-rest, field-level-access-control",
        "financial_data": "immutable-audit-trail, sox-compliant"
      },
      "access_control": {
        "financial_records": "read-write-global",
        "bank_accounts": "read-write",
        "payroll_data": "read-write",
        "vendor_contracts": "read-write",
        "tax_records": "read-write",
        "audit_files": "read-write",
        "budget_documents": "read-write"
      }
    },
    {
      "id": "senior-accountant-01",
      "role": "Senior Accountant",
      "capabilities": [
        "month-end-close",
        "complex-journal-entries",
        "fixed-assets",
        "accruals-analysis",
        "intercompany-accounting",
        "financial-analyses",
        "audit-support",
        "account-reconciliations",
        "gaap-compliance"
      ],
      "model": "qwen-34b",
      "memory_profile": "episodic-enabled, procedural-enabled",
      "tool_requirements": ["erp-system", "email", "document-storage", "analytics-dashboard", "bank-api"],
      "system_prompt": "You are a Senior Accountant handling complex accounting functions for a medium enterprise. You lead the month-end close, prepare complex journal entries, manage fixed assets, perform accrual analyses, and support external audits. You ensure GAAP compliance and mentor junior accountants. You escalate significant discrepancies or unusual transactions to the Finance Manager.",
      "constraints": {
        "max_tokens_per_request": 8192,
        "approval_required_for": ["journal-entries-over-25000", "account-closure", "estimate-modifications"]
      },
      "access_control": {
        "financial_records": "read-write-technical",
        "bank_accounts": "read-only",
        "payroll_data": "read-only",
        "vendor_contracts": "read-only",
        "tax_records": "read-only",
        "fixed_assets": "read-write",
        "audit_files": "read-write"
      }
    },
    {
      "id": "junior-accountant-01",
      "role": "Junior Accountant",
      "capabilities": [
        "basic-journal-entries",
        "account-reconciliations",
        "invoice-processing",
        "expense-review",
        "data-management",
        "basic-reporting",
        "document-organization"
      ],
      "model": "qwen-14b",
      "memory_profile": "semantic-enabled, procedural-enabled",
      "tool_requirements": ["erp-system", "email", "document-storage"],
      "system_prompt": "You are a Junior Accountant supporting the finance team with routine accounting tasks. You prepare basic journal entries, reconcile accounts, process invoices, review expenses, and organize documentation for audits and reviews. You follow established procedures and escalate complex issues to the Senior Accountant. Accuracy and attention to detail are your top priorities.",
      "constraints": {
        "max_tokens_per_request": 4096,
        "approval_required_for": ["journal-entries-over-5000"]
      },
      "access_control": {
