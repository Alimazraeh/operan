  "operational_policies": [
    {
      "id": "pol-fin-001",
      "name": "Agent Autonomy Boundaries",
      "scope": "agent",
      "rules": [
        {
          "agent": "finance-gpo-01",
          "allowed": [
            "scan-invoices",
            "categorize-expenses",
            "data-entry",
            "report-draft",
            "retrieval",
            "expense-processing"
          ],
          "denied": [
            "approve-payments",
            "adjust-ledger",
            "change-bank-accounts",
            "file-taxes",
            "modify-payroll",
            "create-vendors"
          ]
        },
        {
          "agent": "finance-bookkeeper-01",
          "allowed": [
            "journal-entries",
            "reconciliation",
            "ap-processing",
            "ar-processing",
            "expense-categorization"
          ],
          "denied": [
            "override-approvals",
            "close-period-without-review",
            "modify-bank-routes",
            "create-new-vendor-bank-account"
          ]
        },
        {
          "agent": "finance-controller-01",
          "allowed": [
            "all-operations"
          ],
          "denied": [
            "override-audit-logs",
            "delete-posted-entries",
            "bypass-segregation-of-duties"
          ]
        },
        {
          "requirement": "all-agent-output-involving-financial-transactions-requires-human-confirmation-before-execution"
        }
      ]
    },
    {
      "id": "pol-fin-002",
      "name": "Compliance and Audit Readiness",
      "scope": "department",
      "rules": [
        {
          "frequency": "quarterly",
          "action": "review-gaap-compliance-and-update-accounting-policies"
        },
        {
          "frequency": "annually",
          "action": "external-cpa-audit-of-financial-statements"
        },
        {
          "frequency": "monthly",
          "action": "verify-all-accounts-reconciled-within-5-business-days"
        }
      ]
    },
    {
      "id": "pol-fin-003",
      "name": "Data Retention and Disposal",
      "scope": "system",
      "rules": [
        {
          "data_type": "financial-records",
