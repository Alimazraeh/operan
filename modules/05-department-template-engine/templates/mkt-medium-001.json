  "value_streams": [
    {
      "id": "vs-campaign",
      "name": "Campaign-to-Pipeline",
      "description": "From plan to measurable pipeline contribution.",
      "stages": [
        {
          "name": "Plan",
          "inputs": [
            "objectives, audience data"
          ],
          "activities": [
            "campaign planning",
            "budgeting"
          ],
          "outputs": [
            "campaign briefs"
          ]
        },
        {
          "name": "Produce & Publish",
          "inputs": [
            "campaign briefs"
          ],
          "activities": [
            "content creation",
            "social publishing"
          ],
          "outputs": [
            "live campaigns"
          ]
        },
        {
          "name": "Nurture & Measure",
          "inputs": [
            "live campaigns"
          ],
          "activities": [
            "lead nurturing",
            "performance analysis"
          ],
          "outputs": [
