  "workflows": [
    {
      "id": "wf-campaign-001",
      "name": "Campaign Development & Execution",
      "description": "End-to-end campaign lifecycle: strategy, creative, execution, measurement.",
      "triggers": [
        "manual",
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "campaign-01",
          "type": "agent_call",
          "name": "Campaign Strategy",
          "config": {
            "agent": "demand-gen-lead-01",
            "task": "Define campaign objectives, target audience, channels, and KPIs"
          }
        },
        {
          "id": "campaign-02",
          "type": "agent_call",
          "name": "Content Creation",
          "config": {
            "agent": "content-lead-01",
            "task": "Develop content plan, brief designers, create copy"
          }
        },
        {
          "id": "campaign-03",
          "type": "transformation",
          "name": "Creative Production",
          "config": {
            "agent": "brand-designer-01",
            "task": "Create visual assets, video, and creative materials"
          }
        },
        {
          "id": "campaign-04",
          "type": "tool_call",
          "name": "Launch Campaign",
          "config": {
            "tool": "marketing-automation",
            "action": "deploy-to-channels"
          }
        },
        {
          "id": "campaign-05",
          "type": "transformation",
          "name": "Monitor & Optimize",
          "config": {
            "agent": "marketing-ops-01",
            "task": "Monitor performance, A/B test, optimize"
          }
        }
      ]
    },
    {
      "id": "wf-content-001",
      "name": "Content Pipeline",
      "description": "Content creation workflow: ideation, creation, review, publish, promote.",
      "triggers": [
        "manual",
        "schedule:weekly"
      ],
      "steps": [
        {
          "id": "content-01",
          "type": "agent_call",
          "name": "Content Ideation",
          "config": {
            "agent": "content-lead-01",
            "task": "Research topics, plan editorial calendar, prioritize"
          }
        },
        {
          "id": "content-02",
          "type": "transformation",
          "name": "Create Content",
          "config": {
            "agent": "content-lead-01",
            "task": "Write, design, and produce content assets"
          }
        },
        {
          "id": "content-03",
          "type": "approval",
          "name": "Content Review",
          "config": {
            "required_by": "cmo-01",
            "task": "Review for brand alignment and quality"
          }
        },
        {
          "id": "content-04",
          "type": "tool_call",
          "name": "Publish Content",
          "config": {
            "tool": "cms",
            "action": "publish-and-distribute"
          }
        }
      ]
    },
    {
      "id": "wf-analytics-001",
      "name": "Marketing Performance Reporting",
      "description": "Monthly marketing performance review and reporting.",
      "triggers": [
        "schedule:monthly"
      ],
      "steps": [
        {
          "id": "analytics-01",
          "type": "agent_call",
          "name": "Collect Metrics",
          "config": {
            "agent": "marketing-ops-01",
            "task": "Collect campaign metrics, ROI, and KPI data"
          }
        },
        {
          "id": "analytics-02",
          "type": "transformation",
          "name": "Generate Report",
          "config": {
            "agent": "marketing-ops-01",
            "task": "Create performance report with insights and recommendations"
          }
        },
        {
          "id": "analytics-03",
          "type": "notification",
          "name": "Share with Leadership",
          "config": {
            "recipients": [
              "cmo-01",
              "executive-team"
            ],
            "template": "monthly-marketing-report"
          }
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": false,
    "memory_profiles": {
      "cmo-01": "semantic-enabled, graph-enabled, full-retention",
      "content-lead-01": "semantic-enabled, procedural-enabled",
      "demand-gen-lead-01": "semantic-enabled, procedural-enabled",
      "brand-designer-01": "semantic-enabled",
      "marketing-ops-01": "semantic-enabled, procedural-enabled",
      "marketing-gpo-01": "semantic-enabled"
    },
    "retention_policy": {
      "campaign-data": "2-years",
      "analytics": "3-years",
      "content-assets": "indefinite"
    }
  },
  "governance_rules": [
    {
      "id": "gov-mkt-m-001",
      "name": "Brand Approval",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "asset_type": "public-facing"
      },
      "actions": [
        "require-brand-review",
        "check-guidelines",
        "log-usage"
      ]
    },
    {
      "id": "gov-mkt-m-002",
      "name": "Data Privacy",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "data_type": "personal-data"
      },
      "actions": [
        "gdpr-compliant",
        "consent-management",
        "data-minimization"
      ]
    }
  ],
  "kpis": [
    {
      "id": "mkt-kpi-m-001",
      "name": "Marketing Qualified Leads (MQLs)",
      "description": "Number of MQLs generated per month",
      "metric_type": "counter",
      "unit": "leads",
      "thresholds": {
        "target": 200,
        "warning": 150,
        "critical": 100
      },
      "aggregation_period": "month"
    },
    {
      "id": "mkt-kpi-m-002",
      "name": "Cost Per Acquisition (CPA)",
      "description": "Average cost to acquire a customer",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 100,
        "warning": 150,
        "critical": 200
      },
      "aggregation_period": "month"
    },
    {
      "id": "mkt-kpi-m-003",
      "name": "Content Engagement Rate",
      "description": "Average engagement rate across content assets",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 8,
        "warning": 5,
        "critical": 3
      },
      "aggregation_period": "month"
    },
    {
      "id": "mkt-kpi-m-004",
      "name": "Marketing ROI",
      "description": "Return on marketing investment",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 300,
        "warning": 200,
        "critical": 100
      },
      "aggregation_period": "quarter"
    }
  ],
