  "value_streams": [
    {
      "id": "vs-contracts",
      "name": "Contract Lifecycle",
      "description": "From request to signed, tracked obligations.",
      "stages": [
        {
          "name": "Draft & Review",
          "inputs": [
            "contract requests"
          ],
          "activities": [
            "template selection",
            "clause review",
            "risk flags"
          ],
          "outputs": [
            "reviewed drafts"
          ]
        },
        {
          "name": "Negotiate & Sign",
          "inputs": [
            "counterparty redlines"
          ],
          "activities": [
            "negotiation support",
            "approvals",
            "execution"
          ],
          "outputs": [
            "executed contracts"
          ]
        },
        {
          "name": "Track",
          "inputs": [
            "executed contracts"
          ],
          "activities": [
            "obligation tracking",
            "renewal alerts"
          ],
          "outputs": [
            "met obligations, timely renewals"
          ]
        }
      ],
      "outcome": "Contracts move fast without unreviewed risk",
      "business_outcome": "Deal velocity up, contractual exposure down",
      "value_metric_kpi_refs": [
        "legal-kpi-m-001",
        "legal-kpi-m-002"
      ]
    },
    {
      "id": "vs-counsel",
      "name": "Advisory & IP Protection",
      "description": "Legal counsel and intellectual-property defense for the business.",
      "stages": [
