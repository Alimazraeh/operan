  "workflows": [
    {
      "id": "wf-contract-001",
      "name": "Contract Review Process",
      "description": "End-to-end contract review: intake, risk assessment, drafting, approval, execution.",
      "triggers": [
        "manual",
        "event:contract-received"
      ],
      "steps": [
        {
          "id": "contract-01",
          "type": "agent_call",
          "name": "Contract Intake",
          "config": {
            "agent": "legal-paralegal-01",
            "task": "Log contract, categorize type, assign reviewer"
          }
        },
        {
          "id": "contract-02",
          "type": "agent_call",
          "name": "Risk Assessment",
          "config": {
            "agent": "corporate-lawyer-01",
            "task": "Assess legal risk, identify red lines, recommend approach"
          }
        },
        {
          "id": "contract-03",
          "type": "transformation",
          "name": "Draft/Review Contract",
          "config": {
            "agent": "corporate-lawyer-01",
            "task": "Draft or review contract terms, negotiate with counterparty"
          }
        },
        {
          "id": "contract-04",
          "type": "approval",
          "name": "General Counsel Approval",
          "config": {
            "required_by": "general-counsel-01",
            "if": "high-value-or-high-risk"
          }
        },
        {
          "id": "contract-05",
          "type": "tool_call",
          "name": "Execute & Archive",
          "config": {
            "tool": "contract-management",
            "action": "execute-and-archive"
          }
        }
      ]
    },
    {
      "id": "wf-ip-001",
      "name": "IP Portfolio Management",
      "description": "Manage intellectual property: filings, renewals, licensing, and enforcement.",
      "triggers": [
        "schedule:quarterly",
        "event:invention-disclosure"
      ],
      "steps": [
        {
          "id": "ip-01",
          "type": "agent_call",
          "name": "Assess IP",
          "config": {
            "agent": "ip-specialist-01",
            "task": "Evaluate invention disclosure, recommend protection strategy"
          }
        },
        {
          "id": "ip-02",
          "type": "transformation",
          "name": "File IP",
          "config": {
            "agent": "ip-specialist-01",
            "task": "Prepare and file patent/trademark application"
          }
        },
        {
          "id": "ip-03",
          "type": "notification",
          "name": "Track Deadlines",
          "config": {
            "agent": "legal-gpo-01",
            "task": "Monitor renewal dates, send reminders"
          }
        }
      ]
    },
    {
      "id": "wf-compliance-001",
      "name": "Legal Compliance Monitoring",
      "description": "Monitor legal obligations, regulatory changes, and compliance requirements.",
      "triggers": [
        "schedule:monthly",
        "event:regulatory-change"
      ],
      "steps": [
        {
          "id": "compliance-01",
          "type": "agent_call",
          "name": "Monitor Changes",
          "config": {
            "agent": "general-counsel-01",
            "task": "Review regulatory changes, assess impact on business"
          }
        },
        {
          "id": "compliance-02",
          "type": "transformation",
          "name": "Update Policies",
          "config": {
            "agent": "employment-lawyer-01",
            "task": "Update legal policies and procedures"
          }
        },
        {
          "id": "compliance-03",
          "type": "tool_call",
          "name": "Report to Leadership",
          "config": {
            "tool": "email",
            "recipients": [
              "executive-team"
            ],
            "template": "compliance-report"
          }
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": false,
    "memory_profiles": {
      "general-counsel-01": "semantic-enabled, graph-enabled, full-retention",
      "corporate-lawyer-01": "semantic-enabled, procedural-enabled",
      "ip-specialist-01": "semantic-enabled, procedural-enabled",
      "employment-lawyer-01": "semantic-enabled, procedural-enabled",
      "legal-paralegal-01": "semantic-enabled",
      "legal-gpo-01": "semantic-enabled"
    },
    "retention_policy": {
      "contracts": "7-years-post-termination",
      "ip-records": "indefinite",
      "litigation-files": "10-years",
      "employment-records": "5-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-legal-m-001",
      "name": "Attorney-Client Privilege",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "communication_type": "privileged"
      },
      "actions": [
        "encrypt-communications",
        "restrict-access",
        "no-ai-training"
      ]
    },
    {
      "id": "gov-legal-m-002",
      "name": "Contract Approval Authority",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "contract_value_above": "threshold"
      },
      "actions": [
        "require-general-counsel-approval",
        "block-execution-without-approval"
      ]
    }
  ],
  "kpis": [
    {
      "id": "legal-kpi-m-001",
      "name": "Contract Turnaround Time",
      "description": "Average time to complete contract review",
      "metric_type": "gauge",
      "unit": "days",
      "thresholds": {
        "target": 3,
        "warning": 5,
        "critical": 10
      },
      "aggregation_period": "month"
    },
    {
      "id": "legal-kpi-m-002",
      "name": "Contract Volume",
      "description": "Number of contracts processed per quarter",
      "metric_type": "counter",
      "unit": "contracts",
      "thresholds": {
        "target": 100,
        "warning": 80,
        "critical": 50
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "legal-kpi-m-003",
      "name": "IP Filing Success Rate",
      "description": "Percentage of IP applications granted",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 80,
        "warning": 70,
        "critical": 50
      },
      "aggregation_period": "year"
    }
  ],
