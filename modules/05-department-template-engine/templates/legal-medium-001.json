      "id": "pol-legal-m-001",
      "name": "Agent Autonomy",
      "scope": "agent",
      "rules": [
        {
          "agent": "legal-gpo-01",
          "allowed": [
            "retrieval",
            "drafting",
            "reporting",
            "scheduling"
