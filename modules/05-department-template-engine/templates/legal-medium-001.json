      ]
    },
    {
      "id": "pol-legal-m-002",
      "name": "Data Retention",
      "scope": "system",
      "rules": [
        {
          "data_type": "contracts",
          "retention": "7-years-post-termination",
          "disposal": "secure-delete"
        },
        {
          "data_type": "ip-records",
          "retention": "indefinite",
          "disposal": "none"
        },
        {
          "data_type": "litigation-files",
          "retention": "10-years",
          "disposal": "secure-delete"
        }
      ]
    }
  ],
