  "governance_rules": [
    {
      "id": "gov-fin-001",
      "name": "SOX Financial Reporting Integrity",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "report_type": "financial-statements",
        "requirement": "dual-signoff"
      },
      "actions": [
        "cfo-signoff-required",
        "controller-signoff-required",
        "audit-trail",
        "immutable-records"
      ]
    },
    {
      "id": "gov-fin-002",
      "name": "Segregation of Duties",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "rule": "financial-reporter != payment-approver",
        "rule2": "budget-setter != budget-spender"
      },
      "actions": [
        "prevent-concurrent-approval",
        "log-violation",
        "notify-cfo"
      ]
    },
    {
      "id": "gov-fin-003",
      "name": "Confidential Financial Data Protection",
      "type": "data_usage",
      "enforcement": "enforce",
      "conditions": {
        "data_classification": "confidential-financial",
        "access_level": "need-to-know"
      },
      "actions": [
        "encrypt-at-rest",
        "log-all-access",
        "restrict-export",
        "watermark-documents"
      ]
    }
  ],
  "kpis": [
    {
      "id": "fin-kpi-001",
      "name": "Close Cycle Time",
      "description": "Number of business days to complete month-end close",
      "metric_type": "gauge",
      "unit": "days",
      "thresholds": {
        "target": 5,
        "warning": 7,
        "critical": 10
      },
      "aggregation_period": "month"
    },
    {
      "id": "fin-kpi-002",
      "name": "Budget Variance",
      "description": "Actual vs budgeted revenue and expenses as percentage",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 2,
        "warning": 5,
        "critical": 10
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "fin-kpi-003",
      "name": "SOX Compliance Rate",
      "description": "Percentage of SOX controls passing testing",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 100,
        "warning": 95,
        "critical": 90
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "fin-kpi-004",
      "name": "Cash Runway",
      "description": "Number of months current cash can cover operating expenses",
      "metric_type": "gauge",
      "unit": "months",
      "thresholds": {
        "target": 24,
        "warning": 12,
        "critical": 6
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "fin-kpi-005",
      "name": "Days Sales Outstanding (DSO)",
      "description": "Average number of days to collect receivables",
      "metric_type": "gauge",
      "unit": "days",
      "thresholds": {
        "target": 45,
        "warning": 60,
        "critical": 90
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "fin-kpi-006",
      "name": "Audit Finding Closure Rate",
      "description": "Percentage of audit findings remediated on time",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 100,
        "warning": 90,
        "critical": 75
      },
      "aggregation_period": "quarter"
    }
  ],
