  "operational_policies": [
    {
      "id": "pol-fin-001",
      "name": "Agent Autonomy in Finance",
      "scope": "agent",
      "rules": [
        {
          "agent": "finance-gpo-pod-01",
          "allowed": [
            "documentation",
            "data-entry",
            "reporting",
            "scheduling"
          ],
          "denied": [
            "approve-financial-statements",
            "make-payments",
            "approve-journal-entries",
            "conduct-audits"
          ]
        },
        {
          "requirement": "all-agent-actions-affecting-financial-reporting-require-human-confirmation-and-approval"
        }
      ]
    },
    {
      "id": "pol-fin-002",
      "name": "Financial Data Retention",
      "scope": "system",
      "rules": [
        {
          "data_type": "financial-statements",
          "retention": "7-years",
          "disposal": "secure-delete"
        },
        {
          "data_type": "tax-records",
