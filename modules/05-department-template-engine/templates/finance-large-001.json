  "workflows": [
    {
      "id": "wf-close-001",
      "name": "Month-End Close Process",
      "description": "Formalized month-end close process with workstreams, deadlines, and quality gates for SOX compliance.",
      "triggers": [
        "schedule:monthly"
      ],
      "steps": [
        {
          "id": "close-01",
          "type": "agent_call",
          "name": "Close Calendar & Workstream Assignment",
          "config": {
            "agent": "finance-gpo-pod-01",
            "task": "Distribute close calendar, assign workstream owners, set deadlines for each close activity"
          }
        },
        {
          "id": "close-02",
          "type": "transformation",
          "name": "Execute Workstream Activities",
          "config": {
            "agent": "controller-01",
            "task": "Execute AP, AR, GL, fixed assets, payroll, and intercompany reconciliations"
          }
        },
        {
          "id": "close-03",
          "type": "approval",
          "name": "Quality Gate Review",
          "config": {
            "required_by": "vp-finance-01",
            "task": "Review account reconciliations, journal entries, and SOX controls for accuracy"
          }
        },
        {
          "id": "close-04",
          "type": "agent_call",
          "name": "Generate Financial Statements",
          "config": {
            "agent": "controller-01",
            "task": "Generate trial balance, income statement, balance sheet, cash flow statement"
          }
        },
        {
          "id": "close-05",
          "type": "approval",
          "name": "CFO Sign-off",
          "config": {
            "required_by": "cfo-01",
            "task": "Review and approve financial statements for distribution"
          }
        },
        {
          "id": "close-06",
          "type": "notification",
          "name": "Distribute to Stakeholders",
          "config": {
            "recipients": [
              "board",
              "audit-committee",
              "investor-relations"
            ],
            "schedule": "by-close-date"
          }
        }
      ]
    },
    {
      "id": "wf-budget-001",
      "name": "Annual Budgeting & Forecasting",
      "description": "Annual budget cycle with department submissions, consolidation, and quarterly reforecasts.",
      "triggers": [
        "schedule:annual",
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "bud-01",
          "type": "agent_call",
          "name": "Issue Budget Instructions",
          "config": {
            "agent": "finance-gpo-pod-01",
            "task": "Distribute budget instructions, templates, and assumptions to department heads"
          }
        },
        {
          "id": "bud-02",
          "type": "transformation",
          "name": "Consolidate Budget Submissions",
          "config": {
            "agent": "financial-analyst-01",
            "task": "Consolidate department budgets, validate assumptions, identify variances"
          }
        },
        {
          "id": "bud-03",
          "type": "approval",
          "name": "Budget Review & Approval",
          "config": {
            "required_by": "cfo-01",
            "task": "Review consolidated budget, present to executive team and board"
          }
        },
        {
          "id": "bud-04",
          "type": "transformation",
          "name": "Load Approved Budget",
          "config": {
            "agent": "finance-gpo-pod-01",
            "task": "Load approved budget into financial system for tracking"
          }
        }
      ]
    },
    {
      "id": "wf-sox-001",
      "name": "SOX Compliance & Controls Testing",
      "description": "Annual SOX 404 compliance program including control design, testing, and remediation.",
      "triggers": [
        "schedule:quarterly",
        "event:sox-planning"
      ],
      "steps": [
        {
          "id": "sox-01",
          "type": "agent_call",
          "name": "Control Universe Update",
          "config": {
            "agent": "internal-audit-lead-01",
            "task": "Review and update control universe for changes in processes and systems"
          }
        },
        {
          "id": "sox-02",
          "type": "agent_call",
          "name": "Test Key Controls",
          "config": {
            "agent": "internal-audit-lead-01",
            "task": "Perform detailed testing of SOX controls, document workpapers"
          }
        },
        {
          "id": "sox-03",
          "type": "conditional",
          "name": "Deficiency Assessment",
          "config": {
            "condition": "control_test_fails",
            "true_path": "deficiency-reporting-and-remediation",
            "false_path": "controls-pass"
          }
        },
        {
          "id": "sox-04",
          "type": "approval",
          "name": "Management Certification",
          "config": {
            "required_by": "cfo-01",
            "task": "Sign SOX management certification"
          }
        }
      ]
    }
  ],
