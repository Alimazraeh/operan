      "unit": "days",
      "thresholds": {"target": 45, "warning": 55, "critical": 70},
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-large-002",
      "name": "Quality of Hire Composite",
      "description": "Score: 90-day retention (40%) + manager rating (30%) + performance at 1-year (30%)",
      "metric_type": "gauge",
      "unit": "score",
      "thresholds": {"target": 4.2, "warning": 3.7, "critical": 3.2},
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-large-003",
