  "workflows": [
    {
      "id": "wf-onboarding-001",
      "name": "Enterprise Onboarding (500+ employees)",
      "description": "Multi-week onboarding with pre-boarding, structured day-one through 90-day program, buddy assignment, manager enablement, and progress tracking.",
      "triggers": ["manual", "event:new-hire-created"],
      "steps": [
        {
          "id": "onb-01",
          "type": "agent_call",
          "name": "Create Employee Record & Metadata",
          "config": {
            "agent": "hris-lead-01",
            "task": "Create comprehensive employee record with start date, role, level, department, business unit, manager, compensation band, location, security clearance, equipment profile"
          },
          "timeout_seconds": 30
        },
        {
          "id": "onb-02",
          "type": "tool_call",
          "name": "Enterprise IT Provisioning",
          "config": {
            "tools": ["email-account", "calendar", "active-directory", "vpn", "badge-access", "laptop-provisioning", "software-licenses", "system-access"],
            "role_profile": "standard-employee",
            "sla_hours": 48
          }
        },
        {
          "id": "onb-03",
          "type": "notification",
          "name": "Welcome Communications",
          "config": {
            "template": "onboarding/welcome-email",
            "recipients": ["new-hire", "manager", "team", "buddy"],
            "send_schedule": ["day-before-start", "day-1-morning"],
            "cc": ["hrbp-senior-01", "hr-gpo-pod-01"]
          }
        },
        {
          "id": "onb-04",
          "type": "agent_call",
          "name": "Assign Learning Curriculum",
          "config": {
            "agent": "td-lead-01",
            "task": "Assign mandatory compliance training, security training, role-specific technical training, leadership foundations, and company culture modules from LMS"
          }
        },
        {
          "id": "onb-05",
          "type": "transformation",
          "name": "Assign Buddy & Manager 1:1 Schedule",
          "config": {
            "agent": "hr-gpo-pod-01",
            "schedule": ["day-1", "end-week-1", "day-30", "day-60", "day-90"],
            "buddy_assignment": true,
            "templates": ["welcome-1:1", "30-day-check", "60-day-review", "90-day-confirmation"]
          }
        },
        {
          "id": "onb-06",
          "type": "tool_call",
          "name": "Benefits Enrollment",
          "config": {
            "tool": "benefits-portal",
            "enrollment_window": "first-30-days",
            "reminder_schedule": ["day-5", "day-15", "day-25"]
          }
        },
        {
          "id": "onb-07",
          "type": "conditional",
          "name": "Security Clearance & Compliance Check",
          "config": {
            "condition": "role.requires_clearance == true OR location.in_high_risk_region == true",
            "true_path": "initiate-background-check-and-compliance-training",
            "false_path": "complete"
          }
        }
      ],
      "error_handling": {
        "max_retries": 3,
        "fallback": "escalate-to-human",
        "critical_path": ["onb-01", "onb-02", "onb-04"],
        "sla": "48-hours"
      }
    },
    {
      "id": "wf-performance-001",
      "name": "Enterprise Performance Management (OKR + 360)",
      "description": "Quarterly OKR cycle with continuous check-ins, 360-degree feedback, calibration at scale, and development planning.",
      "triggers": ["schedule:quarterly"],
      "steps": [
        {
          "id": "perf-01",
          "type": "notification",
          "name": "Open Review Period",
          "config": {
            "message": "Q4 performance review period is now open. Set OKRs, complete self-assessments by {deadline}.",
            "recipients": ["all-managers", "all-employees"],
            "template": "review-cycle-open"
          }
        },
        {
          "id": "perf-02",
          "type": "agent_call",
          "name": "OKR Setup & Alignment",
          "config": {
            "agent": "hrbp-senior-01",
            "task": "Work with leadership to cascade company OKRs to department and individual OKRs, ensuring vertical and horizontal alignment"
          }
        },
        {
          "id": "perf-03",
          "type": "tool_call",
          "name": "360-Degree Feedback Collection",
          "config": {
            "tool": "survey-system",
            "participants": ["peers", "direct-reports", "manager", "cross-functional", "external-partners"],
            "anonymize": true,
            "min_responses": 5
          }
        },
        {
          "id": "perf-04",
          "type": "agent_call",
          "name": "Draft Manager Evaluations",
          "config": {
            "agent": "hrbp-senior-01",
            "task": "Compile self-assessments, 360 feedback, OKR achievement, and performance data into draft evaluations"
          }
        },
        {
          "id": "perf-05",
          "type": "approval",
          "name": "Calibration at Scale",
          {
            "required_by": "hr-vp-01",
            "task": "Review rating distribution across all business units for consistency, fairness, and DEI compliance"
          }
        },
        {
          "id": "perf-06",
          "type": "transformation",
          "name": "Generate Development Plans",
          "config": {
            "agent": "td-lead-01",
            "task": "Generate individual development plans based on performance ratings, career aspirations, and skill gap analysis"
          }
        },
        {
          "id": "perf-07",
          "type": "notification",
          "name": "Deliver Review and Collect Sign-off",
          "config": {
            "schedule": "manager-employee-1:1",
            "required_sign_off": true,
            "escalate_if_no_response": 7,
            "template": "review-delivery"
          }
        }
      ]
    },
    {
      "id": "wf-hiring-001",
      "name": "Enterprise Hiring Pipeline",
      "description": "Complex multi-stage hiring process with requisition governance, structured interviews, diverse panels, and compliance tracking.",
      "triggers": ["manual", "event:headcount-approved"],
      "steps": [
        {
          "id": "hire-01",
          "type": "agent_call",
          "name": "Create & Validate Requisition",
          "config": {
            "agent": "ta-lead-01",
            "task": "Create requisition with role, level, skills matrix, salary band, team, interview panel, and diversity sourcing plan"
          }
        },
        {
          "id": "hire-02",
          "type": "approval",
          "name": "Multi-Level Requisition Approval",
          "config": {
            "required_by": ["hiring-manager", "department-head", "talent-acquisition", "finance", "workforce-planning"],
            "timeout_hours": 72,
            "approval_matrix": {
              "under_75k": "hiring-manager-only",
              "75k-150k": "hiring-manager-plus-dept-head",
              "over_150k": "hiring-manager-plus-dept-head-plus-finance-plus-hr-vp",
              "executive-level": "ceo-approval"
            }
          }
        },
        {
          "id": "hire-03",
          "type": "tool_call",
          "name": "Global Job Posting",
          "config": {
            "channels": ["linkedin", "indeed", "company-careers", "niche-boards", "referral-program", "campus-boards"],
            "auto_renew": true,
            "renew_days": 14,
            "geo_targeting": true
          }
        },
        {
          "id": "hire-04",
          "type": "agent_call",
          "name": "Structured Screening",
          "config": {
            "agent": "ta-recruiter-01",
            "task": "Screen against minimum requirements, conduct behavioral phone screens, score using structured interview rubric"
          }
        },
        {
          "id": "hire-05",
          "type": "transformation",
          "name": "Multi-Stage Interview Loop",
          "config": {
            "agent": "ta-recruiter-01",
            "stages": ["technical-screen", "case-study", "culture-fit", "final-panel", "executive-meeting"],
            "scorecards": true,
            "diverse_panel_required": true,
            "candidate_feedback_after_each": true
          }
        },
        {
          "id": "hire-06",
          "type": "tool_call",
          "name": "Background & Reference Checks",
          "config": {
            "provider": "enterprise-bg-check",
            "checks": ["criminal", "education", "employment-history", "professional-license", "reference", "credit-check-if-required"],
            "consent_required": true,
            "geo_compliance": true
          }
        },
        {
          "id": "hire-07",
          "type": "notification",
          "name": "Offer Generation & Approval",
          "config": {
            "template": "offer-letter-standard",
            "approval_required": true,
            "approval_by": "compensation-strategy based on level and band",
            "expiration_days": 7
          }
        },
        {
          "id": "hire-08",
          "type": "transformation",
          "name": "Candidate Experience Survey",
          "config": {
            "agent": "ta-lead-01",
            "send_to": "all-candidates",
            "survey_type": "experience-feedback"
          }
        }
      ]
    },
    {
      "id": "wf-compliance-001",
      "name": "Global Compliance Framework",
      "description": "Annual and ongoing compliance program covering data protection, workplace safety, anti-harassment, and industry-specific regulations.",
      "triggers": ["schedule:annual", "event:regulatory-change"],
      "steps": [
        {
          "id": "comp-01",
          "type": "agent_call",
          "name": "Regulatory Landscape Review",
          "config": {
            "agent": "er-specialist-01",
            "task": "Review all applicable regulations across operating regions: GDPR, CCPA, SOX, OSHA, local labor laws"
          }
        },
        {
          "id": "comp-02",
          "type": "tool_call",
          "name": "Update Training Curriculum",
          "config": {
            "tool": "lms-system",
            "modules_by_region": ["gdpr-data-protection", "workplace-safety", "anti-harassment", "code-of-conduct", "industry-specific"],
            "deadline": "60-days",
            "geo_targeting": true
          }
        },
        {
          "id": "comp-03",
          "type": "notification",
          "name": "Assign & Track Training",
          "config": {
            "schedule": ["assignment", "30-day-reminder", "15-day-reminder", "deadline", "post-deadline"],
            "escalation": "manager-notification-if-non-compliant"
          }
        },
        {
          "id": "comp-04",
          "type": "agent_call",
          "name": "Generate Compliance Dashboard",
          "config": {
            "agent": "hris-lead-01",
            "task": "Generate real-time compliance dashboard by region, department, and regulation"
          }
        },
        {
          "id": "comp-05",
          "type": "approval",
          "name": "Compliance Audit Sign-off",
          "config": {
            "required_by": "hr-vp-01",
            "frequency": "quarterly"
          }
        }
      ]
    }
  ],
