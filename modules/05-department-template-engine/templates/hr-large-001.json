  "governance_rules": [
    {
      "id": "gov-hr-large-001",
      "name": "Global PII & Data Protection (GDPR/CCPA/PDPA)",
      "type": "data_usage",
      "enforcement": "enforce",
      "conditions": {
        "data_classification": "PII, special-category-PII, biometric",
        "access_level": "need-to-know-basis, regional-compliance",
        "consent_required": true,
        "right_to_deletion": true
      },
      "actions": ["log-all-access", "encrypt-at-rest-and-transit", "mask-in-logs", "enforce-retention-periods", "enforce-right-to-deletion", "cross-border-transfer-compliance"]
    },
    {
      "id": "gov-hr-large-002",
      "name": "Compensation & Equity Confidentiality",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "field": "compensation, salary, equity, bonus",
        "visible_roles": ["hr-vp-01", "tr-lead-01", "department-heads"]
      },
      "actions": ["deny-access", "log-attempt", "notify-compliance", "audit-trail"]
    },
    {
      "id": "gov-hr-large-003",
      "name": "Segregation of Duties & SOX Compliance",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "rule": "hiring-decision-maker != payroll-approver",
        "rule2": "compensation-setter != compensation-approver"
      },
      "actions": ["prevent-concurrent-approval", "log-violation", "notify-hr-vp", "sox-reporting"]
    },
    {
      "id": "gov-hr-large-004",
      "name": "Investigation Record Integrity & Legal Privilege",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "case_type": "employee-relations-investigation",
        "privilege": "attorney-client"
      },
      "actions": ["immutable-records", "chain-of-custody-tracking", "no-deletion", "legal-hold-enabled", "privileged-access-control"]
    },
    {
      "id": "gov-hr-large-005",
      "name": "Agent Human-in-the-Loop Requirements",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "agent_role": "hr-gpo-pod-01",
        "output_affects_individual": true
      },
      "actions": ["human-review-required", "log-output", "retain-output-for-audit", "model-output-capture"]
    },
    {
      "id": "gov-hr-large-006",
      "name": "Equal Opportunity & Pay Equity Compliance",
      "type": "compliance",
      "enforcement": "enforce",
