  "governance_rules": [
    {
      "id": "gov-dev-l-001",
      "name": "Dual Code Review",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "production-code"
      },
      "actions": [
        "require-minimum-2-approvals",
        "block-merge-without-approval"
      ]
    },
    {
      "id": "gov-dev-l-002",
      "name": "Test Coverage Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "new-feature"
      },
      "actions": [
        "require-minimum-coverage-85",
        "block-merge-if-below"
      ]
    },
    {
      "id": "gov-dev-l-003",
      "name": "Security Scan Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "any-production-code"
      },
      "actions": [
        "mandatory-security-scan",
        "block-merge-if-critical"
      ]
    },
    {
      "id": "gov-dev-l-004",
      "name": "Production Deployment Approval",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "production-deployment"
      },
      "actions": [
        "engineering-director-approval",
        "change-approval-board"
      ]
    }
  ],
  "kpis": [
    {
      "id": "dev-kpi-l-001",
      "name": "Sprint Velocity",
      "description": "Average story points completed per sprint across all teams",
      "metric_type": "counter",
      "unit": "points",
      "thresholds": {
        "target": 80,
        "warning": 50,
        "critical": 30
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-002",
      "name": "Bug Escape Rate",
      "description": "Percentage of bugs found in production vs caught in testing",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 5,
        "warning": 10,
        "critical": 20
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-003",
      "name": "Code Coverage",
      "description": "Percentage of code covered by automated tests",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 85,
        "warning": 70,
        "critical": 55
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-004",
      "name": "Deployment Frequency",
      "description": "Number of production deployments per week",
      "metric_type": "counter",
      "unit": "per-week",
      "thresholds": {
        "target": 10,
        "warning": 5,
        "critical": 2
      },
      "aggregation_period": "week"
    },
    {
      "id": "dev-kpi-l-005",
      "name": "Lead Time for Changes",
      "description": "Average time from code commit to production deployment",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {
        "target": 12,
        "warning": 24,
        "critical": 48
      },
      "aggregation_period": "week"
    },
    {
      "id": "dev-kpi-l-006",
      "name": "Security Incident Count",
      "description": "Number of security vulnerabilities found in production",
      "metric_type": "counter",
      "unit": "incidents",
      "thresholds": {
        "target": 0,
        "warning": 2,
        "critical": 5
      },
      "aggregation_period": "quarter"
    }
  ],
