  "workflows": [
    {
      "id": "wf-feature-001",
      "name": "Enterprise Feature Development",
      "description": "Multi-stage feature development with architecture review, code review gates, automated testing, and staged deployments.",
      "triggers": ["manual", "event:epic-planning"],
      "steps": [
        {
          "id": "feat-01",
          "type": "agent_call",
          "name": "Epic Planning",
          "config": {"agent": "engineering-director-01", "task": "Plan epic scope, assign teams, set milestones, identify dependencies"}
        },
        {
          "id": "feat-02",
          "type": "agent_call",
          "name": "Architecture Design",
          "config": {"agent": "tech-lead-01", "task": "Design technical architecture, create design doc, get architecture review"}
        },
        {
          "id": "feat-03",
          "type": "transformation",
          "name": "Implementation",
          "config": {"agent": "developer", "task": "Write code, write tests, create pull request"}
        },
        {
          "id": "feat-04",
          "type": "approval",
          "name": "Code Review Gate",
          "config": {"required_by": "tech-lead-01", "task": "Review for quality, security, and design alignment"}
        },
        {
          "id": "feat-05",
          "type": "tool_call",
          "name": "CI/CD Pipeline",
          "config": {"tools": ["lint", "test", "build", "security-scan", "performance-test"]}
        },
        {
          "id": "feat-06",
          "type": "tool_call",
          "name": "Deploy to Staging",
          "config": {"tool": "ci-cd", "environment": "staging"}
        },
        {
          "id": "feat-07",
          "type": "approval",
          "name": "QA Sign-off",
          "config": {"required_by": "qa-lead-01", "task": "Verify feature meets requirements and passes all tests"}
        },
        {
          "id": "feat-08",
          "type": "tool_call",
          "name": "Deploy to Production (Canary)",
          "config": {"tool": "ci-cd", "environment": "production", "strategy": "canary"}
        },
        {
          "id": "feat-09",
          "type": "transformation",
          "name": "Monitor & Rollback",
          "config": {"agent": "dev-gpo-pod-01", "task": "Monitor metrics, auto-rollback if error rate exceeds threshold"}
        }
      ]
    },
    {
      "id": "wf-sprint-001",
      "name": "SAFe-Style Agile Delivery",
      "description": "Scaled agile delivery with PI planning, sprint execution, and system demos.",
      "triggers": ["schedule:quarterly", "schedule:bi-weekly"],
      "steps": [
        {
          "id": "sprint-01",
          "type": "agent_call",
          "name": "PI Planning",
          "config": {"agent": "engineering-director-01", "task": "Plan Program Increment, set objectives, identify cross-team dependencies"}
        },
        {
          "id": "sprint-02",
          "type": "transformation",
          "name": "Sprint Execution",
          "config": {"agent": "tech-lead-01", "task": "Execute sprint, track progress, manage blockers"}
        },
        {
          "id": "sprint-03",
          "type": "agent_call",
          "name": "System Demo",
          "config": {"agent": "engineering-director-01", "task": "Demo completed features to stakeholders and business owners"}
        },
        {
          "id": "sprint-04",
          "type": "agent_call",
          "name": "Retrospective & Inspect & Adapt",
          "config": {"agent": "engineering-director-01", "task": "Conduct PI retrospective, identify improvements"}
        }
      ]
    },
    {
      "id": "wf-security-001",
      "name": "Security Review Process",
      "description": "Mandatory security review for all production code changes.",
      "triggers": ["manual", "event:code-reviewed"],
      "steps": [
        {
          "id": "sec-01",
          "type": "tool_call",
          "name": "Automated Security Scan",
          "config": {"tools": ["sast", "dast", "dependency-scan", "secret-scan"]}
        },
        {
          "id": "sec-02",
          "type": "conditional",
          "name": "Scan Results Review",
          "config": {
            "condition": "scan.has_critical_findings == true",
            "true_path": "escalate-to-security-team",
            "false_path": "approve"
          }
        },
        {
          "id": "sec-03",
          "type": "approval",
          "name": "Security Sign-off",
          "config": {"required_by": "tech-lead-01", "if": "manual-review-required"}
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "vp-dev-01": "semantic-enabled, graph-enabled, full-retention",
      "engineering-director-01": "semantic-enabled, procedural-enabled",
      "tech-lead-01": "semantic-enabled, procedural-enabled",
      "frontend-dev-01": "semantic-enabled",
      "backend-dev-01": "semantic-enabled",
      "qa-lead-01": "semantic-enabled, procedural-enabled",
      "dev-gpo-pod-01": "semantic-enabled"
    },
    "retention_policy": {
      "code-reviews": "1-year",
      "deployment-logs": "6-months",
      "bug-reports": "2-years",
      "security-scans": "indefinite",
      "architecture-docs": "5-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-dev-l-001",
      "name": "Dual Code Review",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "production-code"},
      "actions": ["require-minimum-2-approvals", "block-merge-without-approval"]
    },
    {
      "id": "gov-dev-l-002",
      "name": "Test Coverage Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "new-feature"},
      "actions": ["require-minimum-coverage-85", "block-merge-if-below"]
    },
    {
      "id": "gov-dev-l-003",
      "name": "Security Scan Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "any-production-code"},
      "actions": ["mandatory-security-scan", "block-merge-if-critical"]
    },
    {
      "id": "gov-dev-l-004",
      "name": "Production Deployment Approval",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "production-deployment"},
      "actions": ["engineering-director-approval", "change-approval-board"]
    }
  ],
  "kpis": [
    {
      "id": "dev-kpi-l-001",
      "name": "Sprint Velocity",
      "description": "Average story points completed per sprint across all teams",
      "metric_type": "counter",
      "unit": "points",
      "thresholds": {"target": 80, "warning": 50, "critical": 30},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-002",
      "name": "Bug Escape Rate",
      "description": "Percentage of bugs found in production vs caught in testing",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 5, "warning": 10, "critical": 20},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-003",
      "name": "Code Coverage",
      "description": "Percentage of code covered by automated tests",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 85, "warning": 70, "critical": 55},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-l-004",
      "name": "Deployment Frequency",
      "description": "Number of production deployments per week",
      "metric_type": "counter",
      "unit": "per-week",
      "thresholds": {"target": 10, "warning": 5, "critical": 2},
      "aggregation_period": "week"
    },
    {
      "id": "dev-kpi-l-005",
      "name": "Lead Time for Changes",
      "description": "Average time from code commit to production deployment",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {"target": 12, "warning": 24, "critical": 48},
      "aggregation_period": "week"
    },
    {
      "id": "dev-kpi-l-006",
      "name": "Security Incident Count",
      "description": "Number of security vulnerabilities found in production",
      "metric_type": "counter",
      "unit": "incidents",
      "thresholds": {"target": 0, "warning": 2, "critical": 5},
      "aggregation_period": "quarter"
    }
  ],
