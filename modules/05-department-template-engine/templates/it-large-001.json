{
  "id": "it-large-001",
  "name": "Large Enterprise IT Department",
  "description": "15–50+ person IT department for large enterprises (500+ employees). Enterprise IT with dedicated teams for infrastructure, security, cloud, network, helpdesk, and project management. Follows ITIL v4 and enterprise frameworks.",
  "category": "it",
  "version": "1.0.0",
  "metadata": {
    "enterprise_size": "large",
    "department_size": "15-50+ FTE",
    "company_size": "500+ employees",
    "industry": "global",
    "compliance_level": "enterprise",
    "frameworks": ["ITIL-v4", "NIST-CSF", "COBIT", "ISO-27001", "SOC-2"],
    "last_reviewed": "2026-07-17"
  },
  "tags": ["it", "enterprise", "infrastructure", "security", "cloud", "multiple-teams"],
  "status": "published",
  "created_by": "platform",
  "agents": [
