  "workflows": [
    {
      "id": "wf-itsm-001",
      "name": "Enterprise ITSM Process",
      "description": "End-to-end IT service management: incident, problem, change, and request fulfillment.",
      "triggers": [
        "manual",
        "event:ticket-created",
        "event:system-alert"
      ],
      "steps": [
        {
          "id": "itsm-01",
          "type": "tool_call",
          "name": "Auto-Triage",
          "config": {
            "tool": "ticketing-system",
            "action": "auto-categorize-priority"
          }
        },
        {
          "id": "itsm-02",
          "type": "agent_call",
          "name": "Route to Team",
          "config": {
            "agent": "it-gpo-pod-01",
            "task": "Route ticket to appropriate team: infrastructure, security, network, or helpdesk"
          }
        },
        {
          "id": "itsm-03",
          "type": "transformation",
          "name": "Resolve Issue",
          "config": {
            "agent": "assigned-team",
            "task": "Diagnose, resolve, document solution per ITIL standards"
          }
        },
        {
          "id": "itsm-04",
          "type": "approval",
          "name": "SLA Verification",
          "config": {
            "check": "resolution-within-sla",
            "if_fail": "escalate-to-manager"
          }
        },
        {
          "id": "itsm-05",
          "type": "tool_call",
          "name": "Close & Report",
          "config": {
            "tool": "ticketing-system",
            "action": "close-and-generate-report"
          }
        }
      ]
    },
    {
      "id": "wf-change-001",
      "name": "Enterprise Change Management",
      "description": "Formal change management with CAB approval for production changes.",
      "triggers": [
        "manual",
        "event:change-request"
      ],
      "steps": [
        {
          "id": "change-01",
          "type": "agent_call",
          "name": "Change Request",
          "config": {
            "agent": "infrastructure-lead-01",
            "task": "Submit change request with risk assessment, rollback plan, and testing strategy"
          }
        },
        {
          "id": "change-02",
          "type": "approval",
          "name": "CAB Review",
          "config": {
            "required_by": "it-director-01",
            "if": "standard-change",
            "escalate_if": "high-risk"
          }
        },
        {
          "id": "change-03",
          "type": "transformation",
          "name": "Implement Change",
          "config": {
            "agent": "infrastructure-lead-01",
            "task": "Implement change during approved maintenance window"
          }
        },
        {
          "id": "change-04",
          "type": "tool_call",
          "name": "Post-Implementation Review",
          "config": {
            "tools": [
              "health-check",
              "monitoring",
              "user-testing"
            ]
          }
        }
      ]
    },
    {
      "id": "wf-security-001",
      "name": "Security Incident Response",
      "description": "Enterprise security incident response following NIST framework.",
      "triggers": [
        "manual",
        "event:security-alert",
        "event:siem-detection"
      ],
      "steps": [
        {
          "id": "sec-01",
          "type": "tool_call",
          "name": "Detect & Classify",
          "config": {
            "tools": [
              "siem",
              "endpoint-detection"
            ],
            "action": "classify-severity"
          }
        },
        {
          "id": "sec-02",
          "type": "agent_call",
          "name": "Initial Assessment",
          "config": {
            "agent": "security-admin-01",
            "task": "Assess scope, impact, and containment requirements"
          }
        },
        {
          "id": "sec-03",
          "type": "conditional",
          "name": "Severity Escalation",
          "config": {
            "condition": "incident.severity in ['critical', 'high']",
            "true_path": "immediate-escalation-to-director",
            "false_path": "standard-response"
          }
        },
        {
          "id": "sec-04",
          "type": "transformation",
          "name": "Contain & Remediate",
          "config": {
            "agent": "security-admin-01",
            "task": "Contain threat, remediate, preserve evidence"
          }
        },
        {
          "id": "sec-05",
          "type": "notification",
          "name": "Stakeholder Communication",
          "config": {
            "recipients": [
              "it-director-01",
              "legal",
              "executive-team"
            ],
            "if": "critical-severity"
          }
        }
      ]
    }
  ],
