  "workflows": [
    {
      "id": "wf-itsm-001",
      "name": "Enterprise ITSM Process",
      "description": "End-to-end IT service management: incident, problem, change, and request fulfillment.",
      "triggers": ["manual", "event:ticket-created", "event:system-alert"],
      "steps": [
        {
          "id": "itsm-01",
          "type": "tool_call",
          "name": "Auto-Triage",
          "config": {"tool": "ticketing-system", "action": "auto-categorize-priority"}
        },
        {
          "id": "itsm-02",
          "type": "agent_call",
          "name": "Route to Team",
          "config": {"agent": "it-gpo-pod-01", "task": "Route ticket to appropriate team: infrastructure, security, network, or helpdesk"}
        },
        {
          "id": "itsm-03",
          "type": "transformation",
          "name": "Resolve Issue",
          "config": {"agent": "assigned-team", "task": "Diagnose, resolve, document solution per ITIL standards"}
        },
        {
          "id": "itsm-04",
          "type": "approval",
          "name": "SLA Verification",
          "config": {"check": "resolution-within-sla", "if_fail": "escalate-to-manager"}
        },
        {
          "id": "itsm-05",
          "type": "tool_call",
          "name": "Close & Report",
          "config": {"tool": "ticketing-system", "action": "close-and-generate-report"}
        }
      ]
    },
    {
      "id": "wf-change-001",
      "name": "Enterprise Change Management",
      "description": "Formal change management with CAB approval for production changes.",
      "triggers": ["manual", "event:change-request"],
      "steps": [
        {
          "id": "change-01",
          "type": "agent_call",
          "name": "Change Request",
          "config": {"agent": "infrastructure-lead-01", "task": "Submit change request with risk assessment, rollback plan, and testing strategy"}
        },
        {
          "id": "change-02",
          "type": "approval",
          "name": "CAB Review",
          "config": {"required_by": "it-director-01", "if": "standard-change", "escalate_if": "high-risk"}
        },
        {
          "id": "change-03",
          "type": "transformation",
          "name": "Implement Change",
          "config": {"agent": "infrastructure-lead-01", "task": "Implement change during approved maintenance window"}
        },
        {
          "id": "change-04",
          "type": "tool_call",
          "name": "Post-Implementation Review",
          "config": {"tools": ["health-check", "monitoring", "user-testing"]}
        }
      ]
    },
    {
      "id": "wf-security-001",
      "name": "Security Incident Response",
      "description": "Enterprise security incident response following NIST framework.",
      "triggers": ["manual", "event:security-alert", "event:siem-detection"],
      "steps": [
        {
          "id": "sec-01",
          "type": "tool_call",
          "name": "Detect & Classify",
          "config": {"tools": ["siem", "endpoint-detection"], "action": "classify-severity"}
        },
        {
          "id": "sec-02",
          "type": "agent_call",
          "name": "Initial Assessment",
          "config": {"agent": "security-admin-01", "task": "Assess scope, impact, and containment requirements"}
        },
        {
          "id": "sec-03",
          "type": "conditional",
          "name": "Severity Escalation",
          "config": {
            "condition": "incident.severity in ['critical', 'high']",
            "true_path": "immediate-escalation-to-director",
            "false_path": "standard-response"
          }
        },
        {
          "id": "sec-04",
          "type": "transformation",
          "name": "Contain & Remediate",
          "config": {"agent": "security-admin-01", "task": "Contain threat, remediate, preserve evidence"}
        },
        {
          "id": "sec-05",
          "type": "notification",
          "name": "Stakeholder Communication",
          "config": {"recipients": ["it-director-01", "legal", "executive-team"], "if": "critical-severity"}
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "it-director-01": "semantic-enabled, graph-enabled, full-retention",
      "infrastructure-lead-01": "semantic-enabled, procedural-enabled",
      "security-admin-01": "semantic-enabled, procedural-enabled, immutable-storage",
      "network-lead-01": "semantic-enabled, procedural-enabled",
      "helpdesk-manager-01": "semantic-enabled, procedural-enabled",
      "cloud-engineer-01": "semantic-enabled",
      "it-gpo-pod-01": "semantic-enabled"
    },
    "retention_policy": {
      "ticket-history": "5-years",
      "incident-reports": "indefinite",
      "change-logs": "5-years",
      "security-logs": "indefinite",
      "backup-logs": "3-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-it-l-001",
      "name": "Change Advisory Board",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "production-configuration"},
      "actions": ["require-cab-approval", "maintain-audit-trail", "rollback-plan-required"]
    },
    {
      "id": "gov-it-l-002",
      "name": "Security Event Logging",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {"event_type": "security-relevant"},
      "actions": ["immutable-logging", "siem-forwarding", "quarterly-review"]
    },
    {
      "id": "gov-it-l-003",
      "name": "Access Review & Certification",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"review_period": "quarterly"},
      "actions": ["review-all-permissions", "certify-access", "remove-dormant"]
    }
  ],
  "kpis": [
    {
      "id": "it-kpi-l-001",
      "name": "SLA Compliance Rate",
      "description": "Percentage of tickets resolved within SLA",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 95, "warning": 90, "critical": 85},
      "aggregation_period": "week"
    },
    {
      "id": "it-kpi-l-002",
      "name": "System Uptime (Core Systems)",
      "description": "Percentage of time core systems are operational",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 99.99, "warning": 99.9, "critical": 99.5},
      "aggregation_period": "month"
    },
    {
      "id": "it-kpi-l-003",
      "name": "Mean Time to Resolve (MTTR)",
      "description": "Average time to resolve critical incidents",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {"target": 2, "warning": 4, "critical": 8},
      "aggregation_period": "month"
    },
    {
      "id": "it-kpi-l-004",
      "name": "Security Incident Count",
      "description": "Number of security incidents per quarter",
      "metric_type": "counter",
      "unit": "incidents",
      "thresholds": {"target": 0, "warning": 3, "critical": 10},
      "aggregation_period": "quarter"
    },
    {
      "id": "it-kpi-l-005",
      "name": "User Satisfaction Score",
      "description": "Average user satisfaction rating for IT services",
      "metric_type": "gauge",
      "unit": "score",
      "thresholds": {"target": 4.5, "warning": 4.0, "critical": 3.5},
      "aggregation_period": "quarter"
    },
    {
      "id": "it-kpi-l-006",
      "name": "Infrastructure Cost per User",
      "description": "Average IT infrastructure cost per employee",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {"target": 2000, "warning": 2500, "critical": 3000},
      "aggregation_period": "quarter"
    }
  ],
