  "kpis": [
    {
      "id": "it-kpi-l-001",
      "name": "SLA Compliance Rate",
      "description": "Percentage of tickets resolved within SLA",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 95,
        "warning": 90,
        "critical": 85
      },
      "aggregation_period": "week"
    },
    {
      "id": "it-kpi-l-002",
      "name": "System Uptime (Core Systems)",
      "description": "Percentage of time core systems are operational",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 99.99,
        "warning": 99.9,
        "critical": 99.5
