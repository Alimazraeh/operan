        "email-templates",
        "report-generation",
        "onboarding-task-coordination"
      ],
      "system_prompt": "You are an HR support GPO handling routine tasks: drafting onboarding checklists, scheduling interviews, filing compliance forms, answering employee policy questions, generating routine reports, coordinating onboarding tasks across systems. You always route sensitive topics (complaints, disciplinary matters, salary disputes, investigations) to the appropriate human specialist.",
      "memory_profile": "semantic-enabled",
      "tool_requirements": [
        "document-storage",
        "email",
        "templates-library",
        "hris-api"
      ],
      "constraints": {
        "max_tokens_per_request": 2048,
        "sensitive_topics": [
          "discrimination",
