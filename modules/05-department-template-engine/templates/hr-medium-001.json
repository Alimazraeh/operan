  ],
  "workflows": [
    {
      "id": "wf-onboarding-001",
      "name": "Structured Onboarding (50-500 employees)",
      "description": "Multi-phase onboarding covering pre-boarding, day-one, week-one, 30-day, 60-day, and 90-day milestones with manager check-ins.",
      "triggers": [
        "manual",
        "event:new-hire-created"
      ],
      "steps": [
        {
          "id": "onb-01",
          "type": "agent_call",
          "name": "Create Employee Record",
          "config": {
            "agent": "hris-01",
            "task": "Create employee record in HRIS with start date, role, department, manager, compensation band, equipment needs, and security clearance level"
          },
          "timeout_seconds": 30
        },
        {
          "id": "onb-02",
          "type": "tool_call",
          "name": "Provision IT and Physical Access",
          "config": {
            "tools": [
              "email-account",
              "calendar",
              "active-directory",
              "badge-access",
              "laptop-provisioning"
            ],
            "role_required": "standard-employee",
            "sla_hours": 24
          }
        },
        {
          "id": "onb-03",
          "type": "notification",
          "name": "Send Welcome Package",
          "config": {
            "template": "onboarding/welcome-email",
            "recipients": [
              "new-hire",
              "manager",
              "team"
            ],
            "send_before": "day-before-start",
            "cc": [
              "hris-01"
            ]
          }
        },
        {
          "id": "onb-04",
          "type": "agent_call",
          "name": "Assign Training Curriculum",
          "config": {
            "agent": "td-01",
            "task": "Assign mandatory compliance training, role-specific training, and department orientation from LMS based on role and department"
          }
        },
        {
          "id": "onb-05",
          "type": "transformation",
          "name": "Schedule Manager 1:1s and Milestones",
          "config": {
            "agent": "hr-gpo-01",
            "schedule": [
              "day-1",
              "end-of-week-1",
              "day-30",
              "day-60",
              "day-90"
            ],
            "templates": [
              "welcome-1:1",
              "30-day-check",
              "60-day-review",
              "90-day-confirmation"
            ]
          }
        },
        {
          "id": "onb-06",
          "type": "conditional",
          "name": "Security Clearance Check",
          "config": {
            "condition": "role.requires_security_clearance == true",
            "true_path": "initiate-background-check",
            "false_path": "complete"
          }
        }
      ],
      "error_handling": {
        "max_retries": 3,
        "fallback": "escalate-to-human",
        "critical_path": [
          "onb-01",
          "onb-02"
        ]
      }
    },
    {
      "id": "wf-performance-001",
      "name": "Continuous Performance Management",
      "description": "Quarterly review cycle with OKRs, 360-degree feedback, calibration sessions, and development planning.",
      "triggers": [
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "perf-01",
          "type": "notification",
          "name": "Open Review Period",
          "config": {
            "message": "Quarterly performance review period is now open. Set Q4 OKRs and complete self-assessments by {deadline}.",
            "recipients": [
              "all-managers"
            ],
            "template": "review-cycle-open"
          }
        },
        {
          "id": "perf-02",
          "type": "agent_call",
          "name": "OKR Setup",
          "config": {
            "agent": "hrbp-01",
            "task": "Work with managers to finalize quarterly OKRs and KPIs for each team member"
          }
        },
        {
          "id": "perf-03",
          "type": "tool_call",
          "name": "Collect 360 Feedback",
          "config": {
            "tool": "survey-system",
            "participants": [
              "peers",
              "direct-report",
              "manager",
              "cross-functional"
            ],
            "anonymize": true
          }
        },
        {
          "id": "perf-04",
          "type": "agent_call",
          "name": "Draft Manager Evaluations",
          "config": {
            "agent": "hrbp-01",
            "task": "Compile self-assessments, 360 feedback, and performance data into draft evaluations"
          }
        },
        {
          "id": "perf-05",
          "type": "approval",
          "name": "Calibration Session",
          "config": {
            "required_by": "hr-manager-01",
            "task": "Review rating distribution across all teams for consistency and fairness"
          }
        },
        {
          "id": "perf-06",
          "type": "transformation",
          "name": "Generate Development Plans",
          "config": {
            "agent": "td-01",
            "task": "Based on performance ratings and career aspirations, generate individual development plans with recommended training"
          }
        },
        {
          "id": "perf-07",
          "type": "notification",
          "name": "Deliver Review and Collect Sign-off",
          "config": {
            "schedule": "manager-employee-1:1",
            "required_sign_off": true,
            "escalate_if_no_response": 7
          }
        }
      ]
    },
    {
      "id": "wf-hiring-001",
      "name": "Structured Hiring Pipeline",
      "description": "Multi-stage hiring process with requisition approval, structured interviews, scorecards, and background checks.",
      "triggers": [
        "manual",
        "event:headcount-approved"
      ],
      "steps": [
        {
          "id": "hire-01",
          "type": "agent_call",
          "name": "Create Job Requisition",
          "config": {
            "agent": "talent-acq-01",
            "task": "Draft job requisition with role, level, skills matrix, salary band, team, and interview panel"
          }
        },
        {
          "id": "hire-02",
          "type": "approval",
          "name": "Multi-Level Approval",
          "config": {
            "required_by": [
              "hiring-manager",
              "department-head",
              "finance"
            ],
            "timeout_hours": 72,
            "approval_matrix": {
              "under_50k": "hiring-manager-only",
              "50k-150k": "hiring-manager-plus-dept-head",
              "over_150k": "hiring-manager-plus-dept-head-plus-finance"
            }
          }
        },
        {
          "id": "hire-03",
          "type": "tool_call",
          "name": "Post to Job Boards",
          "config": {
            "channels": [
              "linkedin",
              "indeed",
              "company-careers",
              "niche-board"
            ],
            "auto_renew": true,
            "renew_days": 14
          }
        },
        {
          "id": "hire-04",
          "type": "agent_call",
          "name": "Initial Screen",
          "config": {
            "agent": "talent-acq-01",
            "task": "Screen resumes against minimum requirements, conduct phone screens, score candidates"
          }
        },
        {
          "id": "hire-05",
          "type": "transformation",
          "name": "Structured Interview Process",
          "config": {
            "agent": "talent-acq-01",
            "stages": [
              "technical-screen",
              "culture-fit",
              "skills-assessment",
              "final-panel"
            ],
            "scorecards": true,
            "diverse_panel": true
          }
        },
        {
          "id": "hire-06",
          "type": "tool_call",
          "name": "Background Check",
          "config": {
            "provider": "standard-bg-check",
            "checks": [
              "criminal",
              "education",
              "employment-history",
              "reference"
            ],
            "consent_required": true
          }
        },
        {
          "id": "hire-07",
          "type": "notification",
          "name": "Send Offer",
          "config": {
            "template": "offer-letter-standard",
            "approval_required": true,
            "expiration_days": 5
          }
        }
      ]
    },
    {
      "id": "wf-leave-001",
      "name": "Leave Management (Formalized)",
      "description": "Formalized leave workflow with accrual tracking, multi-level approvals for extended leave, and compliance monitoring.",
      "triggers": [
        "manual"
      ],
      "steps": [
        {
          "id": "leave-01",
          "type": "agent_call",
          "name": "Validate Entitlement",
          "config": {
            "agent": "hris-01",
            "task": "Check accrued leave balance, eligibility, and company policy"
          }
        },
        {
          "id": "leave-02",
          "type": "approval",
          "name": "Manager Approval",
          "config": {
            "required_by": "direct-manager",
            "timeout_hours": 48
          }
        },
        {
          "id": "leave-03",
          "type": "conditional",
          "name": "Extended Leave / FMLA Check",
          "config": {
            "condition": "duration > 5 working days OR leave_type in ['medical', 'family-leave', 'bereavement'] and duration > 3",
            "true_path": "hrbp-review-and-compliance-check",
            "false_path": "approve-and-notify"
          }
        },
        {
          "id": "leave-04",
          "type": "transformation",
          "name": "Update Availability",
          "config": {
            "agent": "hr-gpo-01",
            "task": "Update calendar, set out-of-office, notify team, update availability dashboard"
          }
        },
        {
          "id": "leave-05",
          "type": "notification",
          "name": "Return-to-Work Check-in",
          "config": {
            "schedule": "first-day-back",
            "template": "return-to-work-check"
          }
        }
      ]
    },
    {
      "id": "wf-compliance-001",
      "name": "Annual Compliance Training & Audit",
      "description": "Mandatory annual compliance training for all employees, with tracking and escalation.",
      "triggers": [
        "schedule:annual"
      ],
      "steps": [
        {
          "id": "comp-01",
          "type": "agent_call",
          "name": "Update Training Curriculum",
          "config": {
            "agent": "td-01",
            "task": "Review and update mandatory training modules based on regulatory changes and incident learning"
          }
        },
        {
          "id": "comp-02",
          "type": "tool_call",
          "name": "Assign Training to All Employees",
          "config": {
            "tool": "lms-system",
            "modules": [
              "workplace-harassment",
              "data-protection",
              "security-awareness",
              "code-of-conduct"
            ],
            "deadline": "90-days-from-assignment"
          }
        },
        {
          "id": "comp-03",
          "type": "notification",
          "name": "Send Reminders",
          "config": {
            "schedule": [
              "day-30-before-deadline",
              "day-7-before-deadline",
              "on-deadline",
              "day-1-after"
            ],
            "escalate_if": "no_completion"
          }
        },
        {
          "id": "comp-04",
          "type": "agent_call",
          "name": "Generate Compliance Report",
          "config": {
            "agent": "hris-01",
            "task": "Generate completion report by department, flag non-compliant employees, calculate overall compliance rate"
          }
        }
      ]
    },
    {
      "id": "wf-employee-relations-001",
      "name": "Employee Relations Investigation",
      "description": "Formal process for handling employee complaints, investigations, and disciplinary actions.",
      "triggers": [
        "manual",
        "event:complaint-received"
      ],
      "steps": [
        {
          "id": "er-01",
          "type": "agent_call",
          "name": "Initial Intake",
          "config": {
            "agent": "hrbp-01",
            "task": "Document complaint details, identify parties, determine preliminary classification"
          }
        },
        {
          "id": "er-02",
          "type": "conditional",
          "name": "Severity Assessment",
          "config": {
            "condition": "complaint.category in ['harassment', 'discrimination', 'safety-violation', 'fraud']",
            "true_path": "immediate-escalation-to-hr-manager-and-legal",
            "false_path": "standard-investigation"
          }
        },
        {
          "id": "er-03",
          "type": "approval",
          "name": "Investigation Authorization",
          "config": {
            "required_by": "hr-manager-01",
            "timeout_hours": 24
          }
        },
        {
          "id": "er-04",
          "type": "agent_call",
          "name": "Conduct Investigation",
          "config": {
            "agent": "hrbp-01",
            "task": "Interview complainant, respondent, and witnesses. Collect documents. Maintain chain of custody."
          }
        },
        {
          "id": "er-05",
          "type": "transformation",
          "name": "Determine Findings and Recommendations",
          "config": {
            "agent": "hrbp-01",
            "task": "Prepare investigation report with findings, evidence summary, and recommended disposition"
          }
        },
        {
          "id": "er-06",
          "type": "approval",
          "name": "Final Disposition",
          "config": {
            "required_by": "hr-manager-01",
            "options": [
              "no-violation",
              "policy-violation-minor",
              "policy-violation-major",
              "termination"
            ]
          }
        }
      ],
      "error_handling": {
        "critical_path": [
          "er-01",
          "er-04",
          "er-06"
        ],
        "on_failure": "immediate-escalation-to-hr-manager"
      }
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "hr-manager-01": "episodic-enabled, graph-enabled, full-retention",
      "hrbp-01": "episodic-enabled, high-retention-employee-interactions",
      "talent-acq-01": "episodic-enabled, candidate-interaction-history",
      "comp-ben-01": "semantic-enabled, compensation-data-access",
      "td-01": "semantic-enabled, training-content-retrieval",
      "hris-01": "semantic-enabled, procedural-enabled, system-admin-access",
      "hr-gpo-01": "semantic-enabled, template-optimized"
    },
    "retention_policy": {
      "employee_records": "7-years-after-termination",
      "investigation_files": "10-years",
      "application_data": "2-years-after-decision",
      "performance_reviews": "5-years",
      "payroll_data": "7-years",
      "training_records": "3-years"
    },
    "compression_settings": {
      "episodic": "semantic-summary-after-180-days",
      "semantic": "vector-dim-1024",
      "graph": "entity-relation-indexed"
    }
  },
  "governance_rules": [
    {
      "id": "gov-hr-med-001",
      "name": "PII & Data Protection (GDPR/CCPA)",
      "type": "data_usage",
      "enforcement": "enforce",
      "conditions": {
        "data_classification": "PII, special-category-PII",
        "access_level": "need-to-know-basis",
        "consent_required": true
      },
      "actions": [
        "log-all-access",
        "encrypt-at-rest-and-transit",
        "mask-in-logs",
        "enforce-retention-periods"
      ]
    },
    {
      "id": "gov-hr-med-002",
      "name": "Compensation Confidentiality",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "field": "compensation, salary, equity",
        "visible_roles": [
          "hr-manager-01",
          "comp-ben-01",
          "department-heads"
        ]
      },
      "actions": [
        "deny-access",
        "log-attempt",
        "notify-compliance"
      ]
    },
    {
      "id": "gov-hr-med-003",
      "name": "Segregation of Duties",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "rule": "hiring-decision-maker != payroll-approver"
      },
      "actions": [
        "prevent-concurrent-approval",
        "log-violation",
        "notify-hr-manager"
      ]
    },
    {
      "id": "gov-hr-med-004",
      "name": "Investigation Record Integrity",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "case_type": "employee-relations-investigation"
      },
      "actions": [
        "immutable-records",
        "chain-of-custody-tracking",
        "no-deletion",
        "legal-hold-enabled"
      ]
    },
    {
      "id": "gov-hr-med-005",
      "name": "Agent Output Human Review",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "agent_role": "hr-gpo-01",
        "output_affects_individual": true
      },
      "actions": [
        "human-review-required",
        "log-output",
        "retain-output-for-audit"
      ]
    },
    {
      "id": "gov-hr-med-006",
      "name": "Equal Opportunity Compliance",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "process": "hiring, promotion, compensation",
        "frequency": "quarterly"
      },
      "actions": [
        "generate-demographic-report",
        "flag-disparities",
        "notify-hr-manager"
      ]
    }
  ],
  "kpis": [
    {
      "id": "hr-kpi-med-001",
      "name": "Time-to-Fill",
      "description": "Average days from requisition approval to offer acceptance",
      "metric_type": "gauge",
      "unit": "days",
      "thresholds": {
        "target": 40,
        "warning": 45,
        "critical": 55
      },
      "aggregation_period": "month"
    },
    {
      "id": "hr-kpi-med-002",
      "name": "Quality of Hire",
      "description": "Composite score: 90-day retention, manager rating, performance score",
      "metric_type": "gauge",
      "unit": "score",
      "thresholds": {
        "target": 4.0,
        "warning": 3.5,
        "critical": 3.0
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-med-003",
      "name": "Voluntary Turnover Rate",
      "description": "Annual voluntary departure percentage by department",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 12,
        "warning": 16,
        "critical": 22
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-med-004",
      "name": "Employee Net Promoter Score (eNPS)",
      "description": "How likely employees are to recommend the company as a place to work",
      "metric_type": "gauge",
      "unit": "score",
      "thresholds": {
        "target": 40,
        "warning": 25,
        "critical": 10
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-med-005",
      "name": "Training Completion Rate",
      "description": "Percentage of mandatory compliance training completed on time",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 100,
        "warning": 95,
        "critical": 85
      },
      "aggregation_period": "month"
    },
    {
      "id": "hr-kpi-med-006",
      "name": "HR Cost per Employee",
      "description": "Total HR department cost divided by headcount",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 8000,
        "warning": 9500,
        "critical": 11000
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-med-007",
      "name": "Internal Fill Rate",
      "description": "Percentage of open positions filled by internal candidates",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 40,
        "warning": 30,
        "critical": 20
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "hr-kpi-med-008",
      "name": "Offer Acceptance Rate",
      "description": "Percentage of offers accepted vs declined",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 85,
        "warning": 75,
        "critical": 65
      },
      "aggregation_period": "quarter"
    }
  ],
