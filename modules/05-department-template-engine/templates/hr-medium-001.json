{
  "id": "hr-medium-001",
  "name": "Medium Enterprise HR Department",
  "description": "5–20 person HR department for mid-market companies (50–500 employees). Specialized roles: recruiter, HRBP, compensation & benefits, training & development, HRIS analyst, and HR manager. Formalized processes with segregation of duties.",
  "category": "hr",
  "version": "1.1.0",
