  "operational_policies": [
    {
      "id": "pol-hr-med-001",
      "name": "Agent Autonomy Boundaries",
      "scope": "agent",
      "rules": [
        {
          "agent": "hr-gpo-01",
          "allowed": [
            "draft",
            "schedule",
            "retrieval",
            "summary",
            "report-generation"
          ],
          "denied": [
            "make-hiring-decision",
            "terminate-employment",
            "change-compensation",
            "conduct-investigation"
          ]
        },
        {
          "agent": "hris-01",
          "allowed": [
            "data-entry",
            "reporting",
            "system-config",
            "integration-maintenance"
          ],
          "denied": [
            "modify-compensation",
            "change-org-structure"
          ]
        },
        {
          "agent": "talent-acq-01",
          "allowed": [
            "screen",
            "schedule",
            "communicate",
            "score"
          ],
          "denied": [
            "make-final-offer"
          ]
        },
        {
          "requirement": "all-agent-output-affecting-individual-employees-requires-human-confirmation-before-action"
        }
      ]
    },
    {
      "id": "pol-hr-med-002",
      "name": "Compliance & Regulatory Maintenance",
      "scope": "department",
      "rules": [
        {
          "frequency": "quarterly",
          "action": "review-employment-law-updates"
        },
        {
          "frequency": "quarterly",
          "action": "equal-opportunity-analysis"
        },
        {
          "frequency": "annually",
          "action": "update-employee-handbook"
        },
        {
          "frequency": "annually",
          "action": "conduct-compliance-audit"
        },
        {
          "frequency": "annually",
          "action": "update-data-retention-policy"
        }
      ]
    },
    {
      "id": "pol-hr-med-003",
      "name": "Data Retention & Privacy",
      "scope": "system",
      "rules": [
        {
          "data_type": "employee-records",
          "retention": "7-years-post-termination",
          "disposal": "secure-delete"
        },
        {
          "data_type": "investigation-files",
          "retention": "10-years",
          "disposal": "secure-delete"
        },
        {
          "data_type": "application-data",
          "retention": "2-years",
          "disposal": "anonymize"
        },
        {
          "data_type": "performance-reviews",
          "retention": "5-years",
          "disposal": "secure-delete"
        },
        {
          "data_type": "payroll-data",
          "retention": "7-years",
          "disposal": "secure-delete"
        },
        {
          "data_type": "training-records",
          "retention": "3-years",
          "disposal": "anonymize"
        }
      ]
    }
  ],
