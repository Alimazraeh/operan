      "id": "pol-proc-l-001",
      "name": "Agent Autonomy",
      "scope": "agent",
      "rules": [
        {"agent": "procurement-gpo-pod-01", "allowed": ["purchase-order-processing", "vendor-onboarding", "document-management", "reporting"], "denied": ["negotiate-contracts", "select-suppliers", "approve-budgets", "access-contract-terms"]}
