  "workflows": [
    {
      "id": "wf-po-001",
      "name": "Purchase Order Process",
      "description": "End-to-end purchase order processing from request to delivery and payment.",
      "triggers": [
        "manual",
        "event:purchase-request-created"
      ],
      "steps": [
        {
          "id": "po-01",
          "type": "agent_call",
          "name": "Validate Purchase Request",
          "config": {
            "agent": "procurement-gpo-01",
            "task": "Validate purchase request against budget, policy compliance, and preferred vendor list"
          }
        },
        {
          "id": "po-02",
          "type": "approval",
          "name": "Budget Approval",
          "config": {
            "required_by": "requester-manager",
            "timeout_hours": 48,
            "approval_matrix": {
              "under_5k": "manager-only",
              "5k-25k": "manager-plus-dept-head",
              "over_25k": "manager-plus-dept-head-plus-finance"
            }
          }
        },
        {
          "id": "po-03",
          "type": "agent_call",
          "name": "Create Purchase Order",
          "config": {
            "agent": "purchasing-coordinator-01",
            "task": "Create PO against approved vendor contract or generate RFP for new vendor"
          }
        },
        {
          "id": "po-04",
          "type": "transformation",
          "name": "Send PO to Vendor",
          "config": {
            "channel": "procurement-system-or-email",
            "acknowledgment_required": true,
            "acknowledgment_sla_hours": 48
          }
        },
        {
          "id": "po-05",
          "type": "tool_call",
          "name": "Track Delivery & Receive",
          "config": {
            "tool": "procurement-system",
            "notification_on_delivery": true
          }
        },
        {
          "id": "po-06",
          "type": "transformation",
          "name": "3-Way Match Reconciliation",
          "config": {
            "agent": "purchasing-coordinator-01",
            "task": "Match PO, delivery receipt, and invoice before payment release"
          }
        }
      ]
    },
    {
      "id": "wf-sourcing-001",
      "name": "Strategic Sourcing Process",
      "description": "Formal sourcing process for new vendors, category changes, or significant purchases.",
      "triggers": [
        "manual",
        "event:vendor-contract-expiring"
      ],
      "steps": [
        {
          "id": "src-01",
          "type": "agent_call",
          "name": "Market Research & RFP Preparation",
          "config": {
            "agent": "sourcing-specialist-01",
            "task": "Conduct market research, identify potential vendors, prepare RFP/RFS documents"
          }
        },
        {
          "id": "src-02",
          "type": "tool_call",
          "name": "Issue RFP to Vendors",
          "config": {
            "channel": "procurement-system",
            "response_deadline": "21-days",
            "minimum_vendors": 3
          }
        },
        {
          "id": "src-03",
          "type": "agent_call",
          "name": "Evaluate Proposals",
          "config": {
            "agent": "sourcing-specialist-1",
            "task": "Score vendor proposals against evaluation criteria, conduct vendor demonstrations"
          }
        },
        {
          "id": "src-04",
          "type": "approval",
          "name": "Vendor Selection Approval",
          "config": {
            "required_by": "procurement-manager-01",
            "task": "Review evaluation results and recommend vendor selection"
          }
        },
        {
          "id": "src-05",
          "type": "agent_call",
          "name": "Contract Negotiation",
          "config": {
            "agent": "procurement-manager-01",
            "task": "Negotiate contract terms, pricing, SLAs, and service levels"
          }
        },
        {
          "id": "src-06",
          "type": "transformation",
          "name": "Onboard Vendor",
          "config": {
            "agent": "procurement-gpo-01",
            "task": "Add vendor to procurement system, set up payment terms, notify stakeholders"
          }
        }
      ]
    },
    {
      "id": "wf-vendor-001",
      "name": "Vendor Performance Management",
      "description": "Quarterly vendor performance review, scorecard management, and relationship improvement.",
      "triggers": [
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "vend-01",
          "type": "agent_call",
          "name": "Collect Performance Data",
          "config": {
            "agent": "procurement-analyst-01",
            "task": "Collect delivery performance, quality metrics, response times, and cost data for all vendors"
          }
        },
        {
          "id": "vend-02",
          "type": "transformation",
          "name": "Generate Vendor Scorecards",
          "config": {
            "agent": "procurement-analyst-01",
            "scoring_dimensions": [
              "delivery-timeliness",
              "quality",
              "cost-effectiveness",
              "responsiveness",
              "compliance"
            ]
          }
        },
        {
          "id": "vend-03",
          "type": "approval",
          "name": "Vendor Rating Review",
          "config": {
            "required_by": "procurement-manager-01",
            "task": "Review vendor scorecards and assign performance ratings"
          }
        },
        {
          "id": "vend-04",
          "type": "conditional",
          "name": "Corrective Action Trigger",
          "config": {
            "condition": "vendor.rating < 3.0 OR vendor.rating < 3.5 AND trend_decreasing",
            "true_path": "initiate-corrective-action",
            "false_path": "continue-relationship"
          }
        },
        {
          "id": "vend-05",
          "type": "notification",
          "name": "Share Results with Vendor",
          "config": {
            "template": "vendor-scorecard-report",
            "escalate_if": "rating_below_minimum"
          }
        }
      ]
    },
    {
      "id": "wf-spend-001",
      "name": "Monthly Spend Analysis & Reporting",
      "description": "Monthly spend analysis by category, department, and vendor with savings tracking.",
      "triggers": [
        "schedule:monthly"
      ],
      "steps": [
        {
          "id": "spend-01",
          "type": "agent_call",
          "name": "Aggregate Spend Data",
          "config": {
            "agent": "procurement-analyst-01",
            "task": "Aggregate purchase order data, invoice data, and contract data by category, department, and vendor"
          }
        },
        {
          "id": "spend-02",
          "type": "transformation",
          "name": "Generate Spend Reports",
          "config": {
            "agent": "procurement-analyst-01",
            "report_types": [
              "by-category",
              "by-department",
              "by-vendor",
              "by-period",
              "savings-tracking"
            ]
          }
        },
        {
          "id": "spend-03",
          "type": "notification",
          "name": "Distribute to Stakeholders",
          "config": {
            "recipients": [
              "procurement-manager-01",
              "finance-manager-01",
              "department-heads"
            ],
            "template": "monthly-spend-report"
          }
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": false,
    "memory_profiles": {
      "procurement-manager-01": "semantic-enabled, procedural-enabled, full-retention",
      "sourcing-specialist-01": "semantic-enabled, market-data-access",
      "purchasing-coordinator-01": "semantic-enabled, procedural-enabled, transaction-optimized",
      "procurement-analyst-01": "semantic-enabled, spend-data-access",
      "procurement-gpo-01": "semantic-enabled, catalog-retrieval-optimized"
    },
    "retention_policy": {
      "vendor-contracts": "5-years-post-termination",
      "purchase-orders": "7-years",
      "spend-data": "5-years",
      "vendor-scorecards": "3-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-proc-001",
      "name": "Segregation of Duties in Purchasing",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "rule": "purchase-requester != purchase-order-approver != payment-approver"
      },
      "actions": [
        "prevent-concurrent-approval",
        "log-violation",
        "notify-compliance"
      ]
    },
    {
      "id": "gov-proc-002",
      "name": "Vendor Bias Prevention",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "process": "vendor-selection",
        "requirement": "minimum-3-proposals-for-competitive-sourcing"
      },
      "actions": [
        "require-multiple-proposals",
        "document-selection-rationale",
        "audit-trail"
      ]
    },
    {
      "id": "gov-proc-003",
      "name": "Contract Terms Standardization",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "contract_value_over": 10000
      },
      "actions": [
        "legal-review-required",
        "standard-terms-only",
        "deviation-approval"
      ]
    }
  ],
  "kpis": [
    {
      "id": "proc-kpi-001",
      "name": "Cost Savings Achieved",
      "description": "Year-over-year cost savings from sourcing initiatives",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 500000,
        "warning": 350000,
        "critical": 200000
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "proc-kpi-002",
      "name": "Purchase Order Cycle Time",
      "description": "Average days from request to PO issuance",
      "metric_type": "gauge",
      "unit": "days",
      "thresholds": {
        "target": 3,
        "warning": 5,
        "critical": 7
      },
      "aggregation_period": "month"
    },
    {
      "id": "proc-kpi-003",
      "name": "Spend Under Management",
      "description": "Percentage of total spend managed through formal procurement processes",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 85,
        "warning": 75,
        "critical": 60
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "proc-kpi-004",
      "name": "Vendor Compliance Rate",
      "description": "Percentage of vendors meeting SLA requirements",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 95,
        "warning": 85,
        "critical": 70
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "proc-kpi-005",
      "name": "Contract Renewal On-Time Rate",
      "description": "Percentage of contracts renewed or re-competed before expiration",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 100,
        "warning": 90,
        "critical": 75
      },
      "aggregation_period": "quarter"
    }
  ],
