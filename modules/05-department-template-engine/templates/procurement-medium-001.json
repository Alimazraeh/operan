  "operational_policies": [
    {
      "id": "pol-proc-001",
      "name": "Agent Autonomy in Procurement",
      "scope": "agent",
      "rules": [
        {
          "agent": "procurement-gpo-01",
          "allowed": [
            "catalog-search",
            "request-processing",
            "data-entry",
            "reporting"
          ],
          "denied": [
            "approve-purchase-orders",
            "select-vendors",
            "negotiate-contracts",
            "change-pricing"
          ]
        },
        {
          "agent": "purchasing-coordinator-01",
          "allowed": [
            "create-po",
            "track-delivery",
            "reconcile-invoices"
          ],
          "denied": [
            "approve-requests",
            "select-vendors",
            "change-terms"
          ]
        },
        {
          "requirement": "all-agent-actions-above-approval-thresholds-require-human-confirmation"
        }
      ]
    },
    {
      "id": "pol-proc-002",
      "name": "Spend Governance",
      "scope": "department",
      "rules": [
        {
          "frequency": "monthly",
          "action": "spend-analysis-and-reporting"
        },
        {
          "frequency": "quarterly",
          "action": "vendor-performance-review"
        },
        {
          "frequency": "annually",
          "action": "procurement-policy-review"
        },
        {
          "frequency": "annually",
          "action": "contract-renewal-schedule-update"
        }
      ]
    }
  ],
