  "value_streams": [
    {
      "id": "vs-s2p",
      "name": "Source-to-Pay",
      "description": "From need to fulfilled order at the right price and risk.",
      "stages": [
        {
          "name": "Source",
          "inputs": [
            "purchase needs"
          ],
          "activities": [
            "sourcing",
            "vendor evaluation"
          ],
          "outputs": [
            "selected vendors"
          ]
        },
        {
          "name": "Purchase",
          "inputs": [
            "selected vendors"
          ],
          "activities": [
            "PO creation",
            "approvals"
          ],
          "outputs": [
            "confirmed orders"
          ]
        },
        {
          "name": "Manage",
          "inputs": [
            "confirmed orders"
          ],
          "activities": [
            "vendor performance",
            "spend analysis"
          ],
          "outputs": [
            "savings, managed risk"
          ]
        }
      ],
      "outcome": "Spend under control with reliable suppliers",
      "business_outcome": "Realized savings and reduced supplier risk",
      "value_metric_kpi_refs": [
        "proc-kpi-001",
        "proc-kpi-002",
        "proc-kpi-003"
      ]
    }
  ]
