  "value_streams": [
    {
      "id": "vs-restore-service",
      "name": "Restore Service",
      "description": "From disruption signal to verified restoration — the run-the-business loop.",
      "stages": [
        {
          "id": "st-detect",
          "name": "Detect & Triage",
          "inputs": [
            "monitoring alerts",
            "user tickets"
          ],
          "activities": [
            "classify severity",
            "correlate signals",
            "assign owner"
          ],
          "outputs": [
            "prioritized incident"
          ],
          "owner_position_id": "pos-it-lead-01",
          "workflow_ref": "wf-ticket-001"
        },
        {
          "id": "st-diagnose",
          "name": "Diagnose & Fix",
          "inputs": [
            "prioritized incident",
            "runbooks",
            "system access"
          ],
          "activities": [
            "root-cause analysis",
            "apply fix (gated above standard changes)"
          ],
          "outputs": [
            "restored service"
          ],
          "owner_position_id": "pos-it-lead-01"
        },
        {
          "id": "st-verify",
          "name": "Verify & Close",
          "inputs": [
