  "workflows": [
    {
      "id": "wf-contract-lifecycle-001",
      "name": "Enterprise Contract Lifecycle Management",
      "description": "Multi-tier contract lifecycle management for enterprise scale: intake, risk scoring, routing, review, multi-layer negotiation, executive approval gates, execution, and obligation tracking.",
      "triggers": ["manual", "event:contract-request-created"],
      "steps": [
        {
          "id": "clm-01",
          "type": "agent_call",
          "name": "Contract Intake and Classification",
          "config": {
            "agent": "legal-paralegal-pod-01",
            "task": "Capture contract request details: party names, contract type, purpose, business owner, desired timeline, jurisdiction, annual value, and any attached drafts or counterparty terms. Assign tracking ID."
          },
          "timeout_seconds": 30
        },
        {
          "id": "clm-02",
          "type": "agent_call",
          "name": "Automated Risk Scoring",
          "config": {
            "agent": "legal-contract-lead-01",
            "task": "Run automated risk scoring against contract risk model: identify high-risk provisions, non-standard clauses, regulatory requirements, and financial exposure. Assign risk tier: low, medium, high, critical."
          }
        },
        {
          "id": "clm-03",
          "type": "conditional",
          "name": "Risk-Based Routing",
          "config": {
            "condition": "contract.risk_tier",
            "true_path": "tiered-review-routing",
            "false_path": "standard-review"
          }
        },
        {
          "id": "clm-04",
          "type": "approval",
          "name": "Review Path Approval",
          "config": {
            "required_by": "legal-contract-lead-01",
            "timeout_hours": 24,
            "routing": {
              "low": "contract-lead-can-approve",
              "medium": "deputy-gc-review",
              "high": "gc-review-plus-external-counsel",
              "critical": "gc-plus-board-approval"
            }
          }
        },
        {
          "id": "clm-05",
          "type": "agent_call",
          "name": "Draft or Review Contract",
          "config": {
            "agent": "legal-deputy-gc-01",
            "task": "Draft contract from approved template or review counterparty draft with annotations, track-changes version, and commentary on non-standard provisions"
          }
        },
        {
          "id": "clm-06",
          "type": "tool_call",
          "name": "Manage Negotiation Rounds",
          "config": {
            "tools": ["email", "contract-management-system"],
            "max_negotiation_rounds": 7,
            "escalation_after_rounds": 4,
            "sla_hours_per_round": 72
          }
        },
        {
          "id": "clm-07",
          "type": "approval",
          "name": "Executive Approval Gate",
          "config": {
            "required_by": "legal-gc-01",
            "timeout_hours": 48,
            "auto_approve_if": "risk_tier == low AND standard_template AND value < 100000"
          }
        },
        {
          "id": "clm-08",
          "type": "tool_call",
          "name": "Execute and Obligation Tracking",
          "config": {
            "tools": ["docushield", "contract-management-system"],
            "actions": ["send-for-electronic-signature", "track-execution", "archive-final-version", "extract-obligations", "set-renewal-alerts", "trigger-obligation-workflows"]
          }
        },
        {
          "id": "clm-09",
          "type": "notification",
          "name": "Deliver Executed Contract Package",
          "config": {
            "template": "contract-executed-enterprise",
            "recipients": ["contract-requestor", "business-unit-leader"],
            "cc": ["legal-paralegal-pod-01", "contract-lead-01"],
            "attachments": ["executed-contract-pdf", "key-terms-digest", "obligation-tracker", "renewal-calendar"]
          }
        }
      ],
      "error_handling": {
        "max_retries": 3,
        "critical_path": ["clm-02", "clm-04", "clm-07", "clm-08"],
        "on_failure": "escalate-to-general-counsel"
      }
    },
    {
      "id": "wf-ma-001",
      "name": "M&A Due Diligence and Support",
      "description": "End-to-end M&A legal support: target identification, document room management, due diligence review, deal structuring, regulatory approval, and post-merger integration.",
      "triggers": ["manual", "event:ma-deal-initiated"],
      "steps": [
        {
          "id": "ma-01",
          "type": "agent_call",
          "name": "Deal Initiation and Team Assembly",
          "config": {
            "agent": "legal-gc-01",
            "task": "Assemble M&A legal team: lead attorney, contract lead, IP counsel, compliance counsel, paralegals. Define scope, timeline, and deliverables. Engage external counsel as needed."
          }
        },
        {
          "id": "ma-02",
          "type": "tool_call",
          "name": "Set Up Virtual Data Room",
          "config": {
            "tools": ["document-storage", "contract-management-system"],
            "actions": ["create-vdr", "set-access-controls", "organize-data-room-folders", "enable-audit-logging"],
            "access_levels": ["internal-team", "external-counsel", "buyer-authorized"]
          }
        },
        {
          "id": "ma-03",
          "type": "agent_call",
          "name": "Conduct Legal Due Diligence",
          "config": {
            "agent": "legal-paralegal-pod-01",
            "task": "Review target company contracts, corporate records, IP registrations, litigation matters, employment agreements, compliance programs, and regulatory filings. Prepare diligence reports and issue matrices."
          }
        },
        {
          "id": "ma-04",
          "type": "agent_call",
          "name": "Draft Transaction Documents",
          "config": {
            "agent": "legal-deputy-gc-01",
            "task": "Prepare purchase agreement, disclosure schedules, ancillary agreements, and closing documents based on due diligence findings and negotiated terms"
          }
        },
        {
          "id": "ma-05",
          "type": "tool_call",
          "name": "Manage Regulatory Filings",
          "config": {
            "tools": ["document-storage", "email"],
            "filings": ["hart-scott-rodino", "regulatory-approvals", "anti-trust-filings"],
            "coordination": "external-counsel"
          }
        },
        {
          "id": "ma-06",
          "type": "approval",
          "name": "Deal Approval",
          "config": {
            "required_by": ["legal-gc-01", "ceo", "board"],
            "timeout_hours": 72
          }
        },
        {
          "id": "ma-07",
          "type": "transformation",
          "name": "Post-Merger Integration Planning",
          "config": {
            "agent": "legal-deputy-gc-01",
            "task": "Develop integration plan: contract assignment, IP transfer, compliance harmonization, employment terms alignment, and systems integration"
          }
        }
      ],
      "error_handling": {
        "max_retries": 2,
        "critical_path": ["ma-03", "ma-04", "ma-06"],
        "on_failure": "immediate-escalation-to-gc"
      }
    },
    {
      "id": "wf-litigation-001",
      "name": "Litigation Management",
      "description": "End-to-end litigation lifecycle: matter intake, strategy development, external counsel engagement, e-discovery, discovery, trial preparation, settlement, and post-trial.",
      "triggers": ["manual", "event:litigation-received"],
      "steps": [
        {
          "id": "lit-01",
          "type": "agent_call",
          "name": "Matter Intake and Conflict Check",
          "config": {
            "agent": "legal-litigation-mgr-01",
            "task": "Document matter details, parties, claims, damages sought, jurisdiction, and urgency. Run conflicts check. Assign matter number and initial file."
          }
        },
        {
          "id": "lit-02",
          "type": "agent_call",
          "name": "Initial Strategy and Budget",
          "config": {
            "agent": "legal-gc-01",
            "task": "Develop initial litigation strategy, set matter budget, determine whether to handle in-house or engage external counsel, establish case management plan"
          }
        },
        {
          "id": "lit-03",
          "type": "tool_call",
          "name": "Engage External Counsel",
          "config": {
            "tools": ["billing-system", "email"],
            "selection_criteria": ["specialization", "jurisdiction", "fee-arrangement", "past-performance"],
            "fee-arrangements": ["hourly", "capped", "contingency", "blended-rate"]
          }
        },
        {
          "id": "lit-04",
          "type": "tool_call",
          "name": "E-Discovery Management",
          "config": {
            "tools": ["e-discovery-platform"],
            "phases": ["collection", "processing", "review", "production"],
            "custodians": "auto-identify",
            "sla_days": 30
          }
        },
        {
          "id": "lit-05",
          "type": "agent_call",
          "name": "Discovery and Deposition Management",
          "config": {
            "agent": "legal-litigation-mgr-01",
            "task": "Manage document review, prepare witnesses for depositions, draft and respond to interrogatories, prepare motions, and develop trial strategy"
          }
        },
        {
          "id": "lit-06",
          "type": "conditional",
          "name": "Settlement Evaluation",
          "config": {
            "condition": "settlement-opportunity-exists",
            "true_path": "settlement-analysis-and-approval",
            "false_path": "trial-preparation"
          }
        },
        {
          "id": "lit-07",
          "type": "approval",
          "name": "Settlement Authorization",
          "config": {
            "required_by": "legal-gc-01",
            "conditions": ["settlement-within-budget", "legal-advisory-provided"],
            "timeout_hours": 48
          }
        },
        {
          "id": "lit-08",
          "type": "notification",
          "name": "Matter Closure and Lessons Learned",
          "config": {
            "template": "litigation-matter-closed",
            "recipients": ["business-unit-leader", "department-heads"],
            "cc": ["legal-gc-01"],
            "attachments": ["matter-summary", "outcomes-analysis", "lessons-learned"]
          }
        }
      ],
      "error_handling": {
        "max_retries": 2,
        "critical_path": ["lit-02", "lit-04", "lit-07"],
        "on_failure": "immediate-escalation-to-gc"
      }
    },
    {
      "id": "wf-compliance-001",
      "name": "Global Compliance Program Management",
      "description": "Enterprise-wide compliance program: policy management, regulatory monitoring, training, audits, investigations, and reporting to board and regulators.",
      "triggers": ["schedule:quarterly", "event:regulatory-change", "manual"],
      "steps": [
        {
          "id": "comp-01",
          "type": "agent_call",
          "name": "Regulatory Landscape Assessment",
          "config": {
            "agent": "legal-compliance-counsel-01",
            "task": "Assess regulatory changes across all operating jurisdictions. Prioritize impacts by business unit, function, and regulation type."
          }
        },
        {
          "id": "comp-02",
          "type": "agent_call",
          "name": "Compliance Risk Assessment",
          "config": {
            "agent": "legal-compliance-counsel-01",
            "task": "Conduct enterprise-wide compliance risk assessment, identify gaps, prioritize remediation, and update compliance risk matrix"
          }
        },
        {
          "id": "comp-03",
          "type": "tool_call",
          "name": "Update Compliance Program",
          "config": {
            "tools": ["document-storage", "compliance-management-system"],
            "updates": ["policies", "procedures", "training-materials", "code-of-conduct"],
            "version_control": true
          }
        },
        {
          "id": "comp-04",
          "type": "tool_call",
          "name": "Deliver Compliance Training",
          "config": {
            "tools": ["email", "lms-system"],
            "modules": ["code-of-conduct", "anti-corruption", "data-privacy", "workplace-harassment", "sanctions"],
            "completion_target": "100-percent-by-deadline"
          }
        },
        {
          "id": "comp-05",
          "type": "agent_call",
          "name": "Board Compliance Report",
          "config": {
            "agent": "legal-gc-01",
            "task": "Prepare and deliver quarterly compliance report to board: regulatory developments, compliance metrics, audit findings, investigation updates, and remediation status"
          }
        },
        {
          "id": "comp-06",
          "type": "tool_call",
          "name": "Regulatory Filings Management",
          "config": {
            "tools": ["document-storage", "email"],
            "filings": ["sec-filings", "industry-regulatory", "local-government"],
            "calendar": "centralized-filing-calendar"
          }
        }
      ],
      "error_handling": {
        "max_retries": 2,
        "critical_path": ["comp-02", "comp-05"]
      }
    },
    {
      "id": "wf-ip-portfolio-001",
      "name": "Enterprise IP Portfolio Management",
      "description": "Comprehensive IP portfolio management: asset identification, prosecution, licensing, enforcement, open-source compliance, and strategic IP advisory.",
      "triggers": ["manual", "schedule:quarterly"],
      "steps": [
        {
          "id": "ip-01",
          "type": "agent_call",
          "name": "IP Asset Identification",
          "config": {
            "agent": "legal-ip-counsel-01",
            "task": "Identify new intellectual property across the enterprise: inventions, trademarks, domain names, content, trade secrets, and software. Coordinate with engineering, product, and R&D teams."
          }
        },
        {
          "id": "ip-02",
          "type": "tool_call",
          "name": "Prior Art and Clearance Search",
          "config": {
            "tools": ["legal-research-db", "trademark-database", "patent-database"],
            "searches": ["prior-art-search", "trademark-clearance", "domain-availability", "open-source-license-check"],
            "jurisdiction": "us-international"
          }
        },
        {
          "id": "ip-03",
          "type": "agent_call",
          "name": "File IP Applications",
          "config": {
            "agent": "legal-paralegal-pod-01",
            "task": "Prepare and file patent applications, trademark registrations, copyright registrations through USPTO and international offices. Track deadlines and office actions."
          }
        },
        {
          "id": "ip-04",
          "type": "agent_call",
          "name": "Licensing and Enforcement",
          "config": {
            "agent": "legal-ip-counsel-01",
            "task": "Negotiate IP licensing agreements, monitor for infringement, send cease-and-desist letters, coordinate enforcement actions with external counsel"
          }
        },
        {
          "id": "ip-05",
          "type": "notification",
          "name": "Portfolio Health Report",
          "config": {
            "template": "ip-portfolio-quarterly-report",
            "recipients": ["legal-gc-01"],
            "cc": ["legal-deputy-gc-01"],
            "schedule": "quarterly",
            "attachments": ["portfolio-status", "maintenance-schedule", "enforcement-actions", "licensing-revenue"]
          }
        }
      ],
      "error_handling": {
        "max_retries": 2,
        "critical_path": ["ip-03", "ip-04"]
      }
    },
    {
      "id": "wf-employment-law-001",
      "name": "Enterprise Employment Law Advisory",
      "description": "Comprehensive employment law support: policy advisory, investigation oversight, separation management, union/labor relations, and regulatory compliance across jurisdictions.",
      "triggers": ["manual", "event:employment-issue-reported"],
      "steps": [
        {
          "id": "emp-01",
          "type": "agent_call",
          "name": "Case Intake and Classification",
          "config": {
            "agent": "legal-paralegal-pod-01",
            "task": "Document employment issue details: nature, parties, timeline, evidence, jurisdiction, and urgency. Classify: standard, elevated, critical."
          }
        },
        {
          "id": "emp-02",
          "type": "conditional",
          "name": "Severity Assessment",
          "config": {
            "condition": "case.classification in ['critical', 'elevated']",
            "true_path": "immediate-gc-or-employment-counsel-review",
            "false_path": "standard-advisory-path"
          }
        },
        {
          "id": "emp-03",
          "type": "agent_call",
          "name": "Legal Advisory and Investigation Oversight",
          "config": {
            "agent": "legal-employment-counsel-01",
            "task": "Provide legal guidance on employment matter, oversee investigation if warranted, advise on documentation requirements, legal obligations, and recommended actions"
          }
        },
        {
          "id": "emp-04",
          "type": "tool_call",
          "name": "Prepare Advisory Documentation",
          "config": {
            "tools": ["document-storage", "email"],
            "document_type": "attorney-client-privileged-memo",
            "classification": "privileged"
          }
        },
        {
          "id": "emp-05",
          "type": "approval",
          "name": "Action Authorization",
          "config": {
            "required_by": "legal-employment-counsel-01",
            "timeout_hours": 48
          }
        },
        {
          "id": "emp-06",
          "type": "notification",
          "name": "Close with Documentation",
          "config": {
            "template": "employment-matter-closed",
            "recipients": ["hr-vp", "business-unit-leader"],
            "cc": ["legal-paralegal-pod-01"],
            "attachments": ["advisory-memo", "recommended-actions", "documentation-checklist"]
          }
        }
      ],
      "error_handling": {
        "max_retries": 2,
        "critical_path": ["emp-03", "emp-04"],
        "on_failure": "immediate-escalation"
      }
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "legal-gc-01": "episodic-enabled, graph-enabled, full-retention, privileged",
      "legal-deputy-gc-01": "episodic-enabled, graph-enabled, full-retention",
      "legal-contract-lead-01": "episodic-enabled, procedural-enabled, high-retention",
      "legal-ip-counsel-01": "episodic-enabled, procedural-enabled, high-retention",
      "legal-employment-counsel-01": "episodic-enabled, high-retention-privileged",
      "legal-compliance-counsel-01": "semantic-enabled, procedural-enabled, regulatory-indexed",
      "legal-litigation-mgr-01": "episodic-enabled, immutable-storage, litigation-privileged",
      "legal-paralegal-pod-01": "semantic-enabled, procedural-enabled, multi-workstream",
