  "operational_policies": [
    {
      "id": "pol-leg-lg-001",
      "name": "Agent Autonomy Boundaries",
      "scope": "agent",
      "rules": [
        {
          "agent": "legal-gpo-pod-01",
          "allowed": ["scan-contracts", "extract-clauses", "retrieval", "template-management", "deadline-reminders", "document-formatting", "contract-redlining-standard", "obligation-extraction"],
          "denied": ["provide-legal-advice", "interpret-contracts-for-binding-purposes", "recommend-negotiation-strategy", "approve-contracts", "modify-clauses-substantively", "send-legal-opinions", "sign-legal-documents"]
        },
        {
          "agent": "legal-paralegal-pod-01",
          "allowed": ["prepare-contracts-from-templates", "organize-documents", "track-deadlines", "research-assist", "due-diligence-support", "e-discovery-assist", "citation-formatting"],
          "denied": ["provide-legal-advice", "negotiate-contract-terms", "represent-company-in-legal-matters", "sign-legal-documents", "authorize-settlement"]
        },
        {
          "agent": "legal-contract-lead-01",
          "allowed": ["contract-review", "negotiation-within-authority", "template-management", "risk-assessment", "standard-approval"],
          "denied": ["approve-high-risk-contracts", "authorize-settlement", "waive-legal-rights", "bypass-executive-approval-gates"]
        },
        {
          "agent": "legal-gc-01",
          "allowed": ["all-legal-operations"],
          "denied": ["waive-attorney-client-privilege", "authorize-settlement-without-board-approval-if-over-threshold", "bypass-governance-requirements"]
        },
        {
          "requirement": "no-agent-can-provide-binding-legal-advice-without-human-legal-counsel-confirmation"
        }
      ]
    },
    {
      "id": "pol-leg-lg-002",
      "name": "Legal and Regulatory Compliance",
      "scope": "department",
      "rules": [
        {
          "frequency": "quarterly",
          "action": "review-regulatory-changes-and-update-compliance-policies-across-all-jurisdictions"
        },
        {
          "frequency": "annually",
          "action": "full-compliance-audit-and-external-attorney-review-of-compliance-program"
        },
        {
          "frequency": "quarterly",
          "action": "review-contract-template-library-and-clause-database-for-updates-and-improvements"
        },
        {
          "frequency": "annually",
          "action": "comprehensive-risk-assessment-of-all-legal-exposures"
        }
      ]
    },
    {
      "id": "pol-leg-lg-003",
      "name": "Privilege, Confidentiality and Data Security",
      "scope": "system",
      "rules": [
        {
          "data_type": "attorney-client-privileged",
