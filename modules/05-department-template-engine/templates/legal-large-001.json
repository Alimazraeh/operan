  "governance_rules": [
    {
      "id": "gov-leg-large-001",
      "name": "Attorney-Client Privilege Protection",
      "type": "data_usage",
      "enforcement": "enforce",
      "conditions": {
        "data_classification": "attorney-client-privileged, board-privileged",
        "access_level": "legal-team-and-board-members-only"
      },
      "actions": ["restrict-access", "encrypt-at-rest-and-transit", "prevent-export", "log-all-access", "watermark-documents"]
    },
    {
      "id": "gov-leg-large-002",
      "name": "Contract Execution Authority Matrix",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "rule": "no-binding-contract-without-appropriate-approval-tier",
        "approval_matrix": {
          "low_risk_under_100k": "contract-lead-can-sign",
          "medium_risk_under_500k": "deputy-gc-can-sign",
          "high_risk_or_over_500k": "gc-must-sign",
          "ma_or_strategic_transaction": "gc-plus-board-approval"
        }
      },
      "actions": ["block-execution", "notify-legal", "log-violation"]
    },
    {
      "id": "gov-leg-large-003",
      "name": "Litigation File Privilege and Immutability",
      "type": "data_usage",
      "enforcement": "enforce",
      "conditions": {
        "record_types": ["litigation-files", "e-discovery", "external-counsel-files"],
        "modification": "immutable-after-creation"
      },
      "actions": ["preserve-documents", "prevent-modification", "require-copy-for-edits", "maintain-chain-of-custody"]
    },
    {
      "id": "gov-leg-large-004",
      "name": "GPO Pod Legal Boundary",
      "type": "access_control",
      "enforcement": "enforce",
      "conditions": {
        "agent_role": "legal-gpo-pod-01",
        "prohibited_actions": ["provide-legal-advice", "interpret-contracts-for-binding-purposes", "recommend-negotiation-strategy", "approve-contracts"]
      },
      "actions": ["block-output", "log-attempt", "notify-contract-lead"]
    },
    {
      "id": "gov-leg-large-005",
      "name": "Conflict of Interest Screening",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "trigger": "new-matter-intake",
        "check_required": true,
        "scope": "global-all-entities"
      },
      "actions": ["run-conflicts-search", "document-results", "escalate-if-conflict-found"]
    },
    {
      "id": "gov-leg-large-006",
      "name": "External Counsel Budget Control",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "rule": "external-counsel-spending-within-approved-budget",
        "approval_threshold": "100000"
      },
      "actions": ["track-spend", "flag-over-budget", "require-approval", "notify-gc"]
    },
    {
      "id": "gov-leg-large-007",
      "name": "Regulatory Filing Compliance",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "frequency": "regulatory-calendar",
        "scope": "all-jurisdictions",
        "missed_filing": "never-acceptable"
      },
      "actions": ["calendar-tracking", "early-alerts", "immediate-escalation-if-at-risk", "post-mortem-if-missed"]
    }
  ],
