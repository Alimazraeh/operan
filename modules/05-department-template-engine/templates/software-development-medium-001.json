{
  "id": "software-development-medium-001",
  "name": "Medium Software Development Team",
  "description": "10–30 person software development team for mid-market companies (100–1000 employees). Multiple development teams with tech leads, specialized roles (frontend, backend, mobile, QA), and structured delivery processes.",
  "category": "software-development",
  "version": "1.0.0",
  "metadata": {
    "enterprise_size": "medium",
    "department_size": "10-30 FTE",
    "company_size": "100-1000 employees",
    "industry": "general",
    "compliance_level": "formalized",
    "frameworks": ["agile/scrum", "GitOps", "DevOps", "TDD"],
    "last_reviewed": "2026-07-17"
  },
  "tags": ["software-development", "medium", "team-based", "delivery"],
  "status": "published",
  "created_by": "platform",
  "agents": [
    {
      "id": "dev-director-01",
      "role": "Engineering Director — Software Development",
      "capabilities": [
        "delivery-strategy",
        "team-structure",
        "hiring",
        "budget-management",
        "stakeholder-management",
        "technical-roadmap"
      ],
      "model": "qwen-72b",
      "memory_profile": "semantic-enabled, graph-enabled",
      "tool_requirements": ["analytics-dashboard", "project-management", "email", "budget-tool"],
      "system_prompt": "You are the Engineering Director for Software Development. You lead 2-3 development teams, manage delivery, plan the technical roadmap, and report to the VP of Engineering or CTO.",
      "constraints": {"max_tokens_per_request": 8192},
      "access_control": {
        "all-dev-data": "read-write",
        "budget-data": "read-write",
        "project-management": "read-write",
        "code-repos": "read-only"
      }
    },
    {
      "id": "tech-lead-01",
      "role": "Tech Lead",
      "capabilities": [
        "technical-design",
        "code-review",
        "sprint-planning",
        "feature-development",
        "mentoring",
        "tech-debt-management"
      ],
      "model": "qwen-34b",
      "memory_profile": "semantic-enabled, procedural-enabled",
      "tool_requirements": ["git-repo", "project-management", "code-review-tools", "ci-cd"],
      "system_prompt": "You are a Tech Lead for a development team. You design technical solutions, review code, plan sprints, mentor junior developers, and manage technical debt.",
      "constraints": {"max_tokens_per_request": 4096},
      "access_control": {
        "code-repos": "read-write",
        "ci-cd": "read-write",
        "project-management": "read-write"
      }
    },
    {
      "id": "frontend-dev-01",
      "role": "Frontend Developer",
      "capabilities": [
        "ui-development",
        "component-architecture",
        "responsive-design",
        "performance-optimization",
        "accessibility",
        "cross-browser-testing"
      ],
      "model": "qwen-34b",
      "memory_profile": "semantic-enabled",
      "tool_requirements": ["git-repo", "code-editor", "testing-tools", "design-tools"],
      "system_prompt": "You are a Frontend Developer building user interfaces. You create components, optimize performance, ensure accessibility, and implement designs from the UX team.",
      "constraints": {"max_tokens_per_request": 4096},
      "access_control": {
        "code-repos": "read-write",
        "production": "read-only"
      }
    },
    {
      "id": "backend-dev-01",
      "role": "Backend Developer",
      "capabilities": [
        "api-development",
        "database-design",
        "system-architecture",
        "performance-optimization",
        "security-implementation",
        "microservices"
      ],
      "model": "qwen-34b",
      "memory_profile": "semantic-enabled",
      "tool_requirements": ["git-repo", "code-editor", "testing-tools", "database-tools"],
      "system_prompt": "You are a Backend Developer building APIs and services. You design databases, implement APIs, optimize performance, and ensure system security.",
      "constraints": {"max_tokens_per_request": 4096},
      "access_control": {
        "code-repos": "read-write",
        "databases": "read-write",
        "production": "read-only"
      }
    },
    {
      "id": "qa-lead-01",
      "role": "QA Lead",
      "capabilities": [
        "test-strategy",
        "test-automation",
        "performance-testing",
        "release-validation",
        "quality-metrics",
        "bug-tracking"
      ],
      "model": "qwen-34b",
      "memory_profile": "semantic-enabled, procedural-enabled",
      "tool_requirements": ["test-frameworks", "ci-cd", "bug-tracking", "performance-tools"],
      "system_prompt": "You lead QA for the development team. You design test strategies, build automation frameworks, validate releases, and track quality metrics.",
      "constraints": {"max_tokens_per_request": 4096},
