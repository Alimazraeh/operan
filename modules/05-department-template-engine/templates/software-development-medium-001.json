  "governance_rules": [
    {
      "id": "gov-dev-m-001",
      "name": "Code Review Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "production-code"
      },
      "actions": [
        "require-minimum-1-approval",
        "block-merge-without-review"
      ]
    },
    {
      "id": "gov-dev-m-002",
      "name": "Test Coverage Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "new-feature"
      },
      "actions": [
        "require-minimum-coverage-80",
        "block-merge-if-below"
      ]
    },
    {
      "id": "gov-dev-m-003",
      "name": "Security Scan Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "any"
      },
      "actions": [
        "mandatory-security-scan",
        "block-merge-if-critical-findings"
      ]
    }
  ],
  "kpis": [
    {
      "id": "dev-kpi-m-001",
      "name": "Sprint Velocity",
      "description": "Average story points completed per sprint",
      "metric_type": "counter",
      "unit": "points",
      "thresholds": {
        "target": 40,
        "warning": 25,
        "critical": 15
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-002",
      "name": "Bug Escape Rate",
      "description": "Percentage of bugs found in production vs caught in testing",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 8,
        "warning": 15,
        "critical": 25
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-003",
      "name": "Code Coverage",
      "description": "Percentage of code covered by automated tests",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 80,
        "warning": 65,
        "critical": 50
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-004",
      "name": "Deployment Frequency",
      "description": "Number of production deployments per sprint",
      "metric_type": "counter",
      "unit": "per-sprint",
      "thresholds": {
        "target": 4,
        "warning": 2,
        "critical": 1
      },
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-005",
      "name": "Lead Time for Changes",
      "description": "Average time from code commit to production deployment",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {
        "target": 24,
        "warning": 48,
        "critical": 96
      },
      "aggregation_period": "sprint"
    }
  ],
