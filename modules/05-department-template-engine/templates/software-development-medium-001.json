        "bug-tracking": "read-write",
        "ci-cd": "read-write"
      }
    },
    {
      "id": "dev-gpo-pod-01",
      "role": "GPO Pod — Development Support",
      "capabilities": [
        "documentation",
        "report-generation",
        "scheduling",
        "project-tracking",
        "meeting-minutes"
      ],
      "model": "qwen-14b",
      "memory_profile": "semantic-enabled",
      "tool_requirements": ["document-storage", "email", "project-management", "templates-library"],
      "system_prompt": "You are a Dev GPO pod member. You maintain documentation, generate reports, track project milestones, and schedule meetings. Always route technical decisions and code changes to human developers.",
      "constraints": {
        "max_tokens_per_request": 2048,
        "sensitive_topics": ["security-vulnerabilities", "production-issues", "code-reviews"]
      },
      "access_control": {
        "code-repos": "read-only",
        "documentation": "read-write",
        "project-management": "read-only",
        "security-data": "none"
      }
    }
  ],
  "workflows": [
    {
      "id": "wf-feature-001",
      "name": "Feature Development Lifecycle",
      "description": "End-to-end feature development from requirement to production deployment.",
      "triggers": ["manual", "event:sprint-planning"],
      "steps": [
        {
          "id": "feat-01",
          "type": "agent_call",
          "name": "Gather Requirements",
          "config": {"agent": "tech-lead-01", "task": "Gather requirements from product, assess technical feasibility"}
        },
        {
          "id": "feat-02",
          "type": "agent_call",
          "name": "Design Solution",
          "config": {"agent": "tech-lead-01", "task": "Design technical solution, create implementation plan, identify dependencies"}
        },
        {
          "id": "feat-03",
          "type": "transformation",
          "name": "Implement Feature",
          "config": {"agent": "developer", "task": "Write code, write tests, create pull request"}
        },
        {
          "id": "feat-04",
          "type": "approval",
          "name": "Code Review",
          "config": {"required_by": "tech-lead-01", "task": "Review code for quality, security, and design alignment"}
        },
        {
          "id": "feat-05",
          "type": "tool_call",
          "name": "Run CI Pipeline",
          "config": {"tools": ["lint", "test", "build", "security-scan"]}
        },
        {
          "id": "feat-06",
          "type": "tool_call",
          "name": "Deploy to Staging",
          "config": {"tool": "ci-cd", "environment": "staging"}
        },
        {
          "id": "feat-07",
          "type": "approval",
          "name": "QA Sign-off",
          "config": {"required_by": "qa-lead-01", "task": "Verify feature meets requirements and passes tests"}
        },
        {
          "id": "feat-08",
          "type": "tool_call",
          "name": "Deploy to Production",
          "config": {"tool": "ci-cd", "environment": "production"}
        }
      ]
    },
    {
      "id": "wf-bugfix-001",
      "name": "Bug Fix Process",
      "description": "Triage, fix, and verify bug fixes with regression testing.",
      "triggers": ["manual", "event:bug-reported"],
      "steps": [
        {
          "id": "bug-01",
          "type": "agent_call",
          "name": "Triage Bug",
          "config": {"agent": "tech-lead-01", "task": "Assess severity, priority, and reproduce bug"}
        },
        {
          "id": "bug-02",
          "type": "transformation",
          "name": "Fix Bug",
          "config": {"agent": "developer", "task": "Fix bug, write regression test"}
        },
        {
          "id": "bug-03",
          "type": "approval",
          "name": "Code Review",
          "config": {"required_by": "tech-lead-01"}
        },
        {
          "id": "bug-04",
          "type": "tool_call",
          "name": "Verify Fix",
          "config": {"tool": "qa", "task": "Verify fix and regression test pass"}
        }
      ]
    },
    {
      "id": "wf-sprint-001",
      "name": "Sprint Planning & Execution",
      "description": "Bi-weekly sprint cycle with planning, daily standups, review, and retro.",
      "triggers": ["schedule:bi-weekly"],
      "steps": [
        {
          "id": "sprint-01",
          "type": "agent_call",
          "name": "Sprint Planning",
          "config": {"agent": "tech-lead-01", "task": "Plan sprint backlog, estimate stories, assign to developers"}
        },
        {
          "id": "sprint-02",
          "type": "transformation",
          "name": "Daily Standup Tracking",
          "config": {"agent": "dev-gpo-pod-01", "task": "Track daily standup notes, blockers, and progress"}
        },
        {
          "id": "sprint-03",
          "type": "agent_call",
          "name": "Sprint Review",
          "config": {"agent": "tech-lead-01", "task": "Review completed work, demo to stakeholders"}
        },
        {
          "id": "sprint-04",
          "type": "agent_call",
          "name": "Retrospective",
          "config": {"agent": "tech-lead-01", "task": "Conduct retro, identify improvements, update process"}
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": false,
    "memory_profiles": {
      "dev-director-01": "semantic-enabled, graph-enabled",
      "tech-lead-01": "semantic-enabled, procedural-enabled",
      "frontend-dev-01": "semantic-enabled",
      "backend-dev-01": "semantic-enabled",
      "qa-lead-01": "semantic-enabled, procedural-enabled",
      "dev-gpo-pod-01": "semantic-enabled"
    },
    "retention_policy": {
      "code-reviews": "6-months",
      "deployment-logs": "3-months",
      "bug-reports": "1-year",
      "sprint-artifacts": "2-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-dev-m-001",
      "name": "Code Review Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "production-code"},
      "actions": ["require-minimum-1-approval", "block-merge-without-review"]
    },
    {
      "id": "gov-dev-m-002",
      "name": "Test Coverage Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "new-feature"},
      "actions": ["require-minimum-coverage-80", "block-merge-if-below"]
    },
    {
      "id": "gov-dev-m-003",
      "name": "Security Scan Gate",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "any"},
      "actions": ["mandatory-security-scan", "block-merge-if-critical-findings"]
    }
  ],
  "kpis": [
    {
      "id": "dev-kpi-m-001",
      "name": "Sprint Velocity",
      "description": "Average story points completed per sprint",
      "metric_type": "counter",
      "unit": "points",
      "thresholds": {"target": 40, "warning": 25, "critical": 15},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-002",
      "name": "Bug Escape Rate",
      "description": "Percentage of bugs found in production vs caught in testing",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 8, "warning": 15, "critical": 25},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-003",
      "name": "Code Coverage",
      "description": "Percentage of code covered by automated tests",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 80, "warning": 65, "critical": 50},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-004",
      "name": "Deployment Frequency",
      "description": "Number of production deployments per sprint",
      "metric_type": "counter",
      "unit": "per-sprint",
      "thresholds": {"target": 4, "warning": 2, "critical": 1},
      "aggregation_period": "sprint"
    },
    {
      "id": "dev-kpi-m-005",
      "name": "Lead Time for Changes",
      "description": "Average time from code commit to production deployment",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {"target": 24, "warning": 48, "critical": 96},
      "aggregation_period": "sprint"
    }
  ],
