  "workflows": [
    {
      "id": "wf-feature-001",
      "name": "Feature Development Lifecycle",
      "description": "End-to-end feature development from requirement to production deployment.",
      "triggers": [
        "manual",
        "event:sprint-planning"
      ],
      "steps": [
        {
          "id": "feat-01",
          "type": "agent_call",
          "name": "Gather Requirements",
          "config": {
            "agent": "tech-lead-01",
            "task": "Gather requirements from product, assess technical feasibility"
          }
        },
        {
          "id": "feat-02",
          "type": "agent_call",
          "name": "Design Solution",
          "config": {
            "agent": "tech-lead-01",
            "task": "Design technical solution, create implementation plan, identify dependencies"
          }
        },
        {
          "id": "feat-03",
          "type": "transformation",
          "name": "Implement Feature",
          "config": {
            "agent": "developer",
            "task": "Write code, write tests, create pull request"
          }
        },
        {
          "id": "feat-04",
          "type": "approval",
          "name": "Code Review",
          "config": {
            "required_by": "tech-lead-01",
            "task": "Review code for quality, security, and design alignment"
          }
        },
        {
          "id": "feat-05",
          "type": "tool_call",
          "name": "Run CI Pipeline",
          "config": {
            "tools": [
              "lint",
              "test",
              "build",
              "security-scan"
            ]
          }
        },
        {
          "id": "feat-06",
          "type": "tool_call",
          "name": "Deploy to Staging",
          "config": {
            "tool": "ci-cd",
            "environment": "staging"
          }
        },
        {
          "id": "feat-07",
          "type": "approval",
          "name": "QA Sign-off",
          "config": {
            "required_by": "qa-lead-01",
            "task": "Verify feature meets requirements and passes tests"
          }
        },
        {
          "id": "feat-08",
          "type": "tool_call",
          "name": "Deploy to Production",
          "config": {
            "tool": "ci-cd",
            "environment": "production"
          }
        }
      ]
    },
    {
      "id": "wf-bugfix-001",
      "name": "Bug Fix Process",
      "description": "Triage, fix, and verify bug fixes with regression testing.",
      "triggers": [
        "manual",
        "event:bug-reported"
      ],
      "steps": [
        {
          "id": "bug-01",
          "type": "agent_call",
          "name": "Triage Bug",
          "config": {
            "agent": "tech-lead-01",
            "task": "Assess severity, priority, and reproduce bug"
          }
        },
        {
          "id": "bug-02",
          "type": "transformation",
          "name": "Fix Bug",
          "config": {
            "agent": "developer",
            "task": "Fix bug, write regression test"
          }
        },
        {
          "id": "bug-03",
          "type": "approval",
          "name": "Code Review",
          "config": {
            "required_by": "tech-lead-01"
          }
        },
        {
          "id": "bug-04",
          "type": "tool_call",
          "name": "Verify Fix",
          "config": {
            "tool": "qa",
            "task": "Verify fix and regression test pass"
          }
        }
      ]
    },
    {
      "id": "wf-sprint-001",
      "name": "Sprint Planning & Execution",
      "description": "Bi-weekly sprint cycle with planning, daily standups, review, and retro.",
      "triggers": [
        "schedule:bi-weekly"
      ],
      "steps": [
        {
          "id": "sprint-01",
          "type": "agent_call",
          "name": "Sprint Planning",
          "config": {
            "agent": "tech-lead-01",
            "task": "Plan sprint backlog, estimate stories, assign to developers"
          }
        },
        {
          "id": "sprint-02",
          "type": "transformation",
          "name": "Daily Standup Tracking",
          "config": {
            "agent": "dev-gpo-pod-01",
            "task": "Track daily standup notes, blockers, and progress"
          }
        },
        {
          "id": "sprint-03",
          "type": "agent_call",
          "name": "Sprint Review",
          "config": {
            "agent": "tech-lead-01",
            "task": "Review completed work, demo to stakeholders"
          }
        },
        {
          "id": "sprint-04",
          "type": "agent_call",
          "name": "Retrospective",
          "config": {
            "agent": "tech-lead-01",
            "task": "Conduct retro, identify improvements, update process"
          }
        }
      ]
    }
  ],
  "memory_topology": {
