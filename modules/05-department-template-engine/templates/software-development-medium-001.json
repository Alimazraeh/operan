  "operational_policies": [
    {
      "id": "pol-dev-m-001",
      "name": "Agent Autonomy",
      "scope": "agent",
      "rules": [
        {"agent": "dev-gpo-pod-01", "allowed": ["documentation", "reporting", "scheduling", "project-tracking"], "denied": ["write-code", "merge-pull-requests", "deploy-to-production", "approve-code-reviews"]}
      ]
    },
    {
      "id": "pol-dev-m-002",
      "name": "Data Retention",
      "scope": "system",
      "rules": [
        {"data_type": "code-reviews", "retention": "6-months", "disposal": "delete"},
        {"data_type": "bug-reports", "retention": "1-year", "disposal": "anonymize"},
        {"data_type": "sprint-artifacts", "retention": "2-years", "disposal": "archive"}
      ]
    }
  ],
