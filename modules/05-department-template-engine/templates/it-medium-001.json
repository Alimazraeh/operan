  "workflows": [
    {
      "id": "wf-ticket-001",
      "name": "ITSM Ticket Management",
      "description": "ITIL-aligned ticket lifecycle: create, triage, assign, resolve, close.",
      "triggers": [
        "manual",
        "event:ticket-created",
        "event:email-received"
      ],
      "steps": [
        {
          "id": "ticket-01",
          "type": "agent_call",
          "name": "Auto-Triage",
          "config": {
            "agent": "it-gpo-01",
            "task": "Categorize ticket, assign priority, attempt auto-resolution"
          }
        },
        {
          "id": "ticket-02",
          "type": "tool_call",
          "name": "Route Ticket",
          "config": {
            "tool": "ticketing-system",
            "action": "assign-to-team",
            "teams": [
              "infrastructure",
              "security",
              "helpdesk",
              "network"
            ]
          }
        },
        {
          "id": "ticket-03",
          "type": "transformation",
          "name": "Resolve Issue",
          "config": {
            "agent": "assigned-technician",
            "task": "Diagnose, resolve, document solution"
          }
        },
        {
          "id": "ticket-04",
          "type": "approval",
          "name": "User Confirmation",
          "config": {
            "required_by": "ticket-requester",
            "task": "Confirm resolution and satisfaction"
          }
        },
        {
          "id": "ticket-05",
          "type": "tool_call",
          "name": "Close Ticket",
          "config": {
            "tool": "ticketing-system",
            "status": "closed",
            "metrics": [
              "resolution-time",
              "satisfaction"
            ]
          }
        }
      ]
    },
    {
      "id": "wf-change-001",
      "name": "Change Management Process",
      "description": "ITIL-aligned change management for infrastructure changes.",
      "triggers": [
        "manual",
        "event:change-request"
      ],
      "steps": [
        {
          "id": "change-01",
          "type": "agent_call",
          "name": "Change Request",
          "config": {
            "agent": "sys-admin-01",
            "task": "Submit change request with risk assessment and rollback plan"
          }
        },
        {
          "id": "change-02",
          "type": "approval",
          "name": "CAB Review",
          "config": {
            "required_by": "it-manager-01",
            "if": "standard-change",
            "escalate_if": "high-risk"
          }
        },
        {
          "id": "change-03",
          "type": "transformation",
          "name": "Implement Change",
          "config": {
            "agent": "sys-admin-01",
            "task": "Implement change during maintenance window"
          }
        },
        {
          "id": "change-04",
          "type": "tool_call",
          "name": "Verify Change",
          "config": {
            "tools": [
              "health-check",
              "monitoring",
              "user-testing"
            ]
          }
        }
      ]
    },
    {
      "id": "wf-incident-001",
      "name": "Incident Management",
      "description": "Structured incident response for IT outages and service disruptions.",
      "triggers": [
        "manual",
        "event:system-alert"
      ],
      "steps": [
        {
          "id": "incident-01",
          "type": "tool_call",
          "name": "Detect & Classify",
          "config": {
            "tools": [
              "monitoring-system"
            ],
            "action": "classify-severity"
          }
        },
        {
          "id": "incident-02",
          "type": "agent_call",
          "name": "Initial Response",
          "config": {
            "agent": "network-admin-01",
            "task": "Assess impact, communicate status, begin remediation"
          }
        },
        {
          "id": "incident-03",
          "type": "conditional",
          "name": "Severity Check",
          "config": {
            "condition": "incident.severity in ['critical', 'major']",
            "true_path": "escalate-to-it-manager",
            "false_path": "continue-resolution"
          }
        },
        {
          "id": "incident-04",
          "type": "transformation",
          "name": "Resolve & Document",
          "config": {
            "agent": "it-gpo-01",
            "task": "Document root cause, resolution, and preventive measures"
          }
        }
      ]
    }
  ],
