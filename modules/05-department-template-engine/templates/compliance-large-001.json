  "workflows": [
    {
      "id": "wf-risk-001",
      "name": "Quarterly Risk Assessment",
      "description": "Comprehensive enterprise risk assessment across all domains.",
      "triggers": [
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "risk-01",
          "type": "agent_call",
          "name": "Identify Risks",
          "config": {
            "agent": "risk-lead-01",
            "task": "Survey all departments for new risks, review incident logs, update risk register"
          }
        },
        {
          "id": "risk-02",
          "type": "transformation",
          "name": "Score & Prioritize",
          "config": {
            "agent": "risk-lead-01",
            "task": "Score risks using probability-impact matrix, prioritize for treatment"
          }
        },
        {
          "id": "risk-03",
          "type": "approval",
          "name": "CCO Review",
          "config": {
            "required_by": "cco-01",
            "task": "Review risk assessment results, approve treatment plans"
          }
        },
        {
          "id": "risk-04",
          "type": "notification",
          "name": "Report to Leadership",
          "config": {
            "recipients": [
              "executive-team",
              "board"
            ],
            "template": "quarterly-risk-report"
          }
        }
      ]
    },
    {
      "id": "wf-incident-001",
      "name": "Compliance Incident Response",
      "description": "Structured incident response for compliance violations and regulatory incidents.",
      "triggers": [
        "manual",
        "event:incident-detected"
      ],
      "steps": [
        {
          "id": "inc-01",
          "type": "agent_call",
          "name": "Initial Triage",
          "config": {
            "agent": "compliance-analyst-01",
            "task": "Document incident, classify severity, identify affected systems"
          }
        },
        {
          "id": "inc-02",
          "type": "conditional",
          "name": "Severity Assessment",
          "config": {
            "condition": "incident.severity in ['critical', 'high']",
            "true_path": "immediate-escalation",
            "false_path": "standard-response"
          }
        },
        {
          "id": "inc-03",
          "type": "approval",
          "name": "CCO Authorization",
          "config": {
            "required_by": "cco-01",
            "timeout_hours": 4
          }
        },
        {
          "id": "inc-04",
          "type": "agent_call",
          "name": "Investigate",
          "config": {
            "agent": "internal-audit-lead-01",
            "task": "Conduct investigation, collect evidence, document findings"
          }
        },
        {
          "id": "inc-05",
          "type": "notification",
          "name": "Regulatory Notification",
          "config": {
            "if_required": "incident.reports_to_regulator",
            "timeline": "per-regulatory-requirement"
          }
        },
        {
          "id": "inc-06",
          "type": "transformation",
          "name": "Post-Incident Review",
          "config": {
            "agent": "compliance-analyst-01",
            "task": "Document lessons learned, update controls"
          }
        }
      ]
    },
    {
      "id": "wf-policy-001",
      "name": "Policy Lifecycle Management",
      "description": "End-to-end policy lifecycle: draft, review, approve, publish, acknowledge, review.",
      "triggers": [
        "manual",
        "schedule:annual",
        "event:regulatory-change"
      ],
      "steps": [
        {
          "id": "pol-01",
          "type": "agent_call",
          "name": "Draft Policy",
          "config": {
            "agent": "compliance-analyst-01",
            "task": "Draft policy based on regulatory changes or business needs"
          }
        },
        {
          "id": "pol-02",
          "type": "approval",
          "name": "Legal Review",
          "config": {
            "required_by": "cco-01",
            "task": "Review for regulatory compliance and legal adequacy"
          }
        },
        {
          "id": "pol-03",
          "type": "transformation",
          "name": "Publish & Distribute",
          "config": {
            "agent": "compliance-gpo-01",
            "task": "Publish to policy system, notify employees, require acknowledgment"
          }
        },
        {
          "id": "pol-04",
          "type": "notification",
          "name": "Track Acknowledgments",
          "config": {
            "deadline": "14-days",
            "escalate_if": "no_completion"
          }
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "cco-01": "semantic-enabled, graph-enabled, full-retention, immutable",
      "regulatory-lead-01": "semantic-enabled, procedural-enabled",
      "risk-lead-01": "semantic-enabled, procedural-enabled",
      "internal-audit-lead-01": "semantic-enabled, immutable-storage",
      "compliance-analyst-01": "semantic-enabled",
      "compliance-gpo-01": "semantic-enabled"
    },
    "retention_policy": {
      "incident-reports": "7-years",
      "audit-files": "10-years",
      "policies": "5-years-post-revision",
      "risk-register": "indefinite",
      "investigation-files": "indefinite"
    }
  },
  "governance_rules": [
    {
      "id": "gov-comp-l-001",
      "name": "Incident Record Integrity",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "record_type": "incident-report",
        "legal_hold": true
      },
      "actions": [
        "immutable-records",
        "chain-of-custody",
        "no-deletion",
        "legal-hold"
      ]
    },
    {
      "id": "gov-comp-l-002",
      "name": "Regulatory Filing Accuracy",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "filing_type": "regulatory-submission"
      },
      "actions": [
        "dual-review-required",
        "retain-drafts",
        "audit-trail"
      ]
    },
    {
      "id": "gov-comp-l-003",
      "name": "Whistleblower Protection",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "report_type": "whistleblower"
      },
      "actions": [
        "anonymize-reporter",
        "immediate-escalation",
        "no-retaliation",
        "independent-review"
      ]
    }
  ],
  "kpis": [
    {
      "id": "comp-kpi-l-001",
      "name": "Policy Acknowledgment Rate",
      "description": "Percentage of employees who have acknowledged current policies",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 100,
        "warning": 95,
        "critical": 85
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "comp-kpi-l-002",
      "name": "Incident Response Time",
      "description": "Average time from incident detection to initial response",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {
        "target": 4,
        "warning": 12,
        "critical": 24
      },
      "aggregation_period": "quarter"
