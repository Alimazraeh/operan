    {
      "id": "comp-kpi-l-004",
      "name": "Risk Mitigation Completion",
      "description": "Percentage of identified risks with approved mitigations implemented on time",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 90,
        "warning": 80,
        "critical": 65
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "comp-kpi-l-005",
      "name": "Compliance Training Completion",
      "description": "Percentage of employees completing mandatory compliance training",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 98,
        "warning": 90,
        "critical": 80
      },
      "aggregation_period": "quarter"
    }
  ],
