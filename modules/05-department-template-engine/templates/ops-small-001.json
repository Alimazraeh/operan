      "scope": "service",
      "service_ref": "svc-service-desk",
      "status": "open",
      "review_cadence": "monthly"
    },
    {
      "id": "risk-sensitive-data-tickets",
      "name": "Sensitive data exposure in tickets",
      "description": "Credentials or personal data pasted into tickets get retained in memory.",
      "category": "compliance",
      "severity": "high",
      "likelihood": "possible",
      "mitigation": "Data-usage governance rule; retention policy on memory topology; redaction guidance in agent prompts.",
      "owner_position_id": "pos-sys-admin-01",
      "scope": "department",
      "status": "mitigating",
      "review_cadence": "quarterly"
    },
    {
      "id": "risk-cost-runaway",
      "name": "Agent execution cost runaway",
      "description": "Runaway loops or oversized prompts inflate model spend.",
      "category": "financial",
      "severity": "medium",
      "likelihood": "possible",
      "mitigation": "Per-agent execution budgets and cost-governance caps; weekly cost review in operating cadence.",
