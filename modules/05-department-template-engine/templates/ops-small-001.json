  "risks": [
    {
      "id": "risk-unauth-permission",
      "name": "Unauthorized permission change by an agent",
      "description": "An AI agent grants or modifies access without human approval.",
      "category": "security",
      "severity": "high",
      "likelihood": "possible",
      "mitigation": "All permission changes routed through the supervision approval gate; access-control governance rule enforced; full audit trail.",
