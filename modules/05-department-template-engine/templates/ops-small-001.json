    {
      "id": "risk-hallucinated-command",
      "name": "Incorrect infrastructure command by an AI agent",
      "description": "An execute-tier agent issues a destructive or wrong command.",
      "category": "model",
      "severity": "critical",
      "likelihood": "possible",
      "mitigation": "Execute tier is gated: mutations beyond standard changes require supervision-gate approval; sandbox dry-run before production execution.",
      "owner_position_id": "pos-sys-admin-01",
      "scope": "agent",
      "agent_def_id": "sys-admin-01",
      "status": "mitigating",
      "review_cadence": "monthly"
    },
    {
      "id": "risk-desk-outage",
      "name": "AI service-desk outage",
      "description": "The AI first line becomes unavailable, leaving users unsupported.",
      "category": "operational",
      "severity": "medium",
      "likelihood": "possible",
      "mitigation": "Human on-call escalation path; platform observability alerts on agent health.",
