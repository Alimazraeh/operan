      "id": "pol-ops-s-001",
      "name": "Agent Autonomy",
      "scope": "agent",
      "rules": [
        {
          "agent": "ops-gpo-01",
          "allowed": [
            "alert-monitoring",
            "log-analysis",
            "reporting",
            "documentation"
