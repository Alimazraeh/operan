      "id": "pol-ops-l-001",
      "name": "Agent Autonomy",
      "scope": "agent",
      "rules": [
        {"agent": "ops-gpo-pod-01", "allowed": ["alert-monitoring", "log-analysis", "reporting", "documentation", "scheduling", "sla-monitoring", "change-tracking"], "denied": ["change-infrastructure", "modify-security-settings", "access-production-data", "deploy-to-production", "access-security-logs"]}
      ]
    },
