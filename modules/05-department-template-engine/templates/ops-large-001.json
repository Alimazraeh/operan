    "retention_policy": {
      "incident-reports": "indefinite",
      "alert-logs": "2-years",
      "operational-docs": "5-years",
      "security-logs": "indefinite",
      "automation-scripts": "indefinite",
      "slo-reports": "5-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-ops-l-001",
      "name": "Change Advisory Board",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"change_type": "production-configuration"},
      "actions": ["require-cab-approval", "maintain-audit-trail", "rollback-plan-required", "change-window-restriction"]
    },
    {
      "id": "gov-ops-l-002",
      "name": "Security Event Logging",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {"event_type": "security-relevant"},
      "actions": ["immutable-logging", "siem-forwarding", "quarterly-review", "compliance-reporting"]
    },
    {
      "id": "gov-ops-l-003",
      "name": "Access Control & Certification",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"review_period": "quarterly"},
      "actions": ["review-all-permissions", "certify-access", "remove-dormant", "document-justification"]
    },
    {
      "id": "gov-ops-l-004",
      "name": "Backup & Disaster Recovery",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {"data_type": "critical-data"},
      "actions": ["verify-daily", "test-restores-quarterly", "document-results", "dr-exercise-annually"]
    }
  ],
  "kpis": [
    {
      "id": "ops-kpi-l-001",
      "name": "System Uptime (Core Systems)",
      "description": "Percentage of time core systems are operational",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 99.99, "warning": 99.9, "critical": 99.5},
      "aggregation_period": "month"
    },
    {
      "id": "ops-kpi-l-002",
      "name": "Mean Time to Detect (MTTD)",
      "description": "Average time to detect incidents across all systems",
      "metric_type": "gauge",
      "unit": "minutes",
      "thresholds": {"target": 2, "warning": 5, "critical": 15},
      "aggregation_period": "month"
    },
    {
      "id": "ops-kpi-l-003",
      "name": "Mean Time to Resolve (MTTR)",
      "description": "Average time to resolve critical incidents",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {"target": 1, "warning": 2, "critical": 4},
      "aggregation_period": "month"
    },
    {
      "id": "ops-kpi-l-004",
      "name": "SLO Compliance Rate",
      "description": "Percentage of services meeting their SLO targets",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 99, "warning": 95, "critical": 90},
      "aggregation_period": "month"
    },
    {
      "id": "ops-kpi-l-005",
      "name": "Automation Coverage",
      "description": "Percentage of routine operations tasks automated",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 90, "warning": 80, "critical": 65},
      "aggregation_period": "quarter"
    },
    {
      "id": "ops-kpi-l-006",
      "name": "Security Incident Count",
      "description": "Number of security incidents per quarter",
      "metric_type": "counter",
      "unit": "incidents",
      "thresholds": {"target": 0, "warning": 2, "critical": 5},
      "aggregation_period": "quarter"
    }
  ],
