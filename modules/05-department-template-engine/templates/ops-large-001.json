  "workflows": [
    {
      "id": "wf-monitor-001",
      "name": "Enterprise Infrastructure Monitoring",
      "description": "24/7 monitoring of all enterprise infrastructure, services, and security events.",
      "triggers": [
        "continuous"
      ],
      "steps": [
        {
          "id": "monitor-01",
          "type": "tool_call",
          "name": "Collect All Metrics",
          "config": {
            "tools": [
              "monitoring-system",
              "log-aggregator",
              "siem"
            ],
            "action": "collect-all-metrics-logs-and-security-events"
          }
        },
        {
          "id": "monitor-02",
          "type": "agent_call",
          "name": "AI-Powered Analysis",
          "config": {
            "agent": "ops-gpo-pod-01",
            "task": "Analyze alerts with AI, triage severity, correlate events, filter noise"
          }
        },
        {
          "id": "monitor-03",
          "type": "conditional",
          "name": "Intelligent Routing",
          "config": {
            "condition": "alert.severity in ['critical', 'high']",
            "true_path": "page-on-call-and-escalate",
            "false_path": "route-to-ticket"
          }
        }
      ]
    },
    {
      "id": "wf-incident-001",
      "name": "Enterprise Incident Management",
      "description": "Structured incident response with severity levels, escalation, and post-incident review.",
      "triggers": [
        "manual",
        "event:incident-detected",
        "event:sla-breach"
      ],
      "steps": [
        {
          "id": "incident-01",
          "type": "tool_call",
          "name": "Auto-Detect & Classify",
          "config": {
            "tools": [
              "monitoring-system",
              "siem"
            ],
            "action": "classify-incident-severity-and-domain"
          }
        },
        {
          "id": "incident-02",
          "type": "agent_call",
          "name": "Triage & Response",
          "config": {
            "agent": "noc-lead-01",
            "task": "Triage incident, assign responders, communicate status to stakeholders"
          }
        },
        {
          "id": "incident-03",
          "type": "conditional",
          "name": "Severity Escalation",
          "config": {
            "condition": "incident.severity in ['critical']",
            "true_path": "escalate-to-it-ops-director-and-soc",
            "false_path": "continue-resolution"
          }
        },
        {
          "id": "incident-04",
          "type": "transformation",
          "name": "Resolve & Remediate",
          "config": {
            "agent": "assigned-team",
            "task": "Resolve incident, remediate root cause, verify recovery"
          }
        },
        {
          "id": "incident-05",
          "type": "agent_call",
          "name": "Post-Incident Review",
          "config": {
            "agent": "it-ops-director-01",
            "task": "Conduct blameless post-mortem, document lessons learned, identify improvements"
          }
        }
      ]
    },
    {
      "id": "wf-reliability-001",
      "name": "Reliability Engineering Program",
      "description": "SRE practices: error budgets, SLOs, capacity planning, and chaos engineering.",
      "triggers": [
        "schedule:monthly",
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "reliability-01",
          "type": "agent_call",
          "name": "Review SLOs",
          "config": {
            "agent": "sre-lead-01",
            "task": "Review service level objectives, analyze error budget consumption"
          }
        },
        {
          "id": "reliability-02",
          "type": "transformation",
          "name": "Capacity Planning",
          "config": {
            "agent": "sre-lead-01",
            "task": "Analyze trends, forecast capacity needs, plan scaling"
          }
        },
        {
          "id": "reliability-03",
          "type": "tool_call",
          "name": "Chaos Experiment",
          "config": {
            "tool": "chaos-engineering",
            "action": "run-fault-injection-test"
          }
        }
      ]
    },
    {
      "id": "wf-automation-001",
      "name": "Infrastructure Automation Program",
      "description": "Continuous automation of infrastructure, deployments, and operations.",
      "triggers": [
        "manual",
        "schedule:monthly"
      ],
      "steps": [
        {
          "id": "automation-01",
          "type": "agent_call",
          "name": "Identify Automation Opportunities",
          "config": {
            "agent": "devops-lead-01",
            "task": "Identify manual tasks and processes suitable for automation"
          }
        },
        {
          "id": "automation-02",
          "type": "transformation",
          "name": "Build & Test Automation",
          "config": {
            "agent": "devops-lead-01",
            "task": "Develop automation, write tests, review, and deploy"
          }
        },
        {
          "id": "automation-03",
          "type": "tool_call",
          "name": "Deploy & Monitor",
          "config": {
            "tool": "ci-cd",
            "action": "deploy-automation-and-monitor-effectiveness"
          }
        }
      ]
    }
  ],
