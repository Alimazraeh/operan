  "workflows": [
    {
      "id": "wf-monitor-001",
      "name": "Infrastructure Monitoring",
      "description": "Continuous monitoring of all infrastructure components and services.",
      "triggers": [
        "continuous"
      ],
      "steps": [
        {
          "id": "monitor-01",
          "type": "tool_call",
          "name": "Collect Metrics",
          "config": {
            "tools": [
              "monitoring-system",
              "log-aggregator"
            ],
            "action": "collect-all-metrics-and-logs"
          }
        },
        {
          "id": "monitor-02",
          "type": "agent_call",
          "name": "Analyze & Triage",
          "config": {
            "agent": "ops-gpo-pod-01",
            "task": "Analyze alerts, triage severity, filter noise"
          }
        },
        {
          "id": "monitor-03",
          "type": "conditional",
          "name": "Route Alerts",
          "config": {
            "condition": "alert.severity in ['critical', 'high']",
            "true_path": "page-on-call",
            "false_path": "route-to-ticket"
          }
        }
      ]
    },
    {
      "id": "wf-incident-001",
      "name": "Incident Management",
      "description": "Structured incident response following ITIL best practices.",
      "triggers": [
        "manual",
        "event:incident-detected"
      ],
      "steps": [
        {
          "id": "incident-01",
          "type": "tool_call",
          "name": "Detect & Classify",
          "config": {
            "tools": [
              "monitoring-system"
            ],
            "action": "classify-incident-severity"
          }
        },
        {
          "id": "incident-02",
          "type": "agent_call",
          "name": "Initial Response",
          "config": {
            "agent": "senior-sys-admin-01",
            "task": "Assess impact, communicate status, begin remediation"
          }
        },
        {
          "id": "incident-03",
          "type": "conditional",
          "name": "Severity Escalation",
          "config": {
            "condition": "incident.severity in ['critical', 'major']",
            "true_path": "escalate-to-ops-manager",
            "false_path": "continue-resolution"
          }
        },
        {
          "id": "incident-04",
          "type": "transformation",
          "name": "Resolve & Document",
          "config": {
            "agent": "senior-sys-admin-01",
            "task": "Resolve incident, document root cause and remediation"
          }
        },
        {
          "id": "incident-05",
          "type": "agent_call",
          "name": "Post-Incident Review",
          "config": {
            "agent": "ops-manager-01",
            "task": "Conduct post-mortem, identify improvements"
          }
        }
      ]
    },
    {
      "id": "wf-automation-001",
      "name": "Infrastructure Automation",
      "description": "Automate routine operations, deployments, and configurations.",
      "triggers": [
        "manual",
        "schedule:daily"
      ],
      "steps": [
        {
          "id": "automation-01",
          "type": "agent_call",
          "name": "Identify Automation Opportunities",
          "config": {
            "agent": "devops-engineer-01",
            "task": "Identify manual tasks suitable for automation"
          }
        },
        {
          "id": "automation-02",
          "type": "transformation",
          "name": "Build Automation",
          "config": {
            "agent": "devops-engineer-01",
            "task": "Develop automation scripts, test, and deploy"
          }
        },
        {
          "id": "automation-03",
          "type": "tool_call",
          "name": "Deploy & Monitor",
          "config": {
            "tool": "ci-cd",
            "action": "deploy-automation-and-monitor"
          }
        }
      ]
    }
  ],
