  "workflows": [
    {
      "id": "wf-arch-001",
      "name": "Architecture Review Process",
      "description": "Formal architecture review for all significant technical changes, new systems, and major feature development.",
      "triggers": ["manual", "event:design-proposal-submitted"],
      "steps": [
        {
          "id": "arch-01",
          "type": "agent_call",
          "name": "Submit Design Proposal",
          "config": {
            "agent": "eng-gpo-pod-01",
            "task": "Collect design proposal, technical specs, security considerations, and performance requirements"
          }
        },
        {
          "id": "arch-02",
          "type": "agent_call",
          "name": "Architecture Review",
          "config": {
            "agent": "architect-lead-01",
            "task": "Review against architecture standards, identify risks, assess technical debt impact, evaluate alternatives"
          }
        },
        {
          "id": "arch-03",
          "type": "approval",
          "name": "Architecture Board Approval",
          "config": {
            "required_by": "vp-eng-01",
            "task": "Review and approve architecture proposal with conditions if any"
          }
        },
        {
          "id": "arch-04",
          "type": "transformation",
          "name": "Document Architecture Decision",
          "config": {
            "agent": "eng-gpo-pod-01",
            "task": "Record architecture decision in ADR database, notify stakeholders"
          }
        }
      ]
    },
    {
      "id": "wf-incident-001",
      "name": "Enterprise Incident Response",
      "description": "Multi-severity incident response with defined roles, escalation paths, and post-mortem processes.",
      "triggers": ["manual", "event:system-alert"],
      "steps": [
        {
          "id": "inc-01",
          "type": "agent_call",
          "name": "Initial Triage & Severity Assessment",
          "config": {
            "agent": "sre-lead-01",
            "task": "Assess incident severity (P1-P4), identify affected systems, estimate impact"
          }
        },
        {
          "id": "inc-02",
          "type": "conditional",
          "name": "Severity-Based Escalation",
          "config": {
            "condition": "incident.severity in ['P1', 'P2']",
            "true_path": "immediate-escalation-to-eng-director",
            "false_path": "standard-response"
          }
        },
        {
          "id": "inc-03",
          "type": "agent_call",
          "name": "Incident Command & Mitigation",
          "config": {
            "agent": "sre-lead-01",
            "task": "Lead incident command, coordinate response, implement mitigation, communicate status"
          }
        },
        {
          "id": "inc-04",
          "type": "notification",
          "name": "Stakeholder Communication",
          "config": {
            "recipients": ["vp-eng-01", "customers-if-impacted"],
            "frequency": "every-15-minutes-for-p1"
          }
        },
        {
          "id": "inc-05",
          "type": "transformation",
          "name": "Post-Incident Review",
          "config": {
            "agent": "sre-lead-01",
            "task": "Conduct blameless post-mortem, identify root cause, create action items"
          }
        }
      ],
      "error_handling": {
        "critical_path": ["inc-01", "inc-03"],
        "on_failure": "immediate-escalation-to-eng-director"
      }
    },
    {
      "id": "wf-security-001",
      "name": "Security Vulnerability Management",
      "description": "End-to-end vulnerability management from discovery to remediation.",
      "triggers": ["manual", "event:vulnerability-detected", "schedule:weekly"],
      "steps": [
        {
          "id": "sec-01",
          "type": "agent_call",
          "name": "Vulnerability Discovery",
          "config": {
            "agent": "security-eng-01",
            "task": "Run security scans, review vulnerability reports, identify CVEs"
          }
        },
        {
          "id": "sec-02",
          "type": "transformation",
          "name": "Risk Assessment & Prioritization",
          "config": {
            "agent": "security-eng-01",
            "methodology": "cvss-scoring",
            "sla_by_severity": {"critical": "24-hours", "high": "7-days", "medium": "30-days"}
          }
        },
        {
          "id": "sec-03",
          "type": "approval",
          "name": "Remediation Plan Approval",
          "config": {
            "required_by": "vp-eng-01",
            "task": "Approve remediation plan for critical and high vulnerabilities"
          }
        },
        {
          "id": "sec-04",
          "type": "transformation",
          "name": "Deploy Security Fixes",
          "config": {
            "agent": "eng-gpo-pod-01",
            "task": "Coordinate with engineering teams to deploy security patches"
          }
        },
        {
          "id": "sec-05",
          "type": "agent_call",
          "name": "Verify Remediation",
          "config": {
            "agent": "security-eng-01",
            "task": "Verify fixes via re-scanning, confirm no regressions"
          }
        }
      ]
    }
  ],
  "memory_topology": {
    "semantic_enabled": true,
    "episodic_enabled": true,
    "procedural_enabled": true,
    "graph_enabled": true,
    "memory_profiles": {
      "vp-eng-01": "semantic-enabled, graph-enabled, full-retention",
      "eng-director-01": "semantic-enabled, procedural-enabled",
      "architect-lead-01": "semantic-enabled, procedural-enabled",
      "sre-lead-01": "semantic-enabled, procedural-enabled, immutable-storage",
      "security-eng-01": "semantic-enabled, procedural-enabled, immutable-storage",
      "qa-lead-01": "semantic-enabled, procedural-enabled",
      "eng-gpo-pod-01": "semantic-enabled, documentation-optimized"
    },
    "retention_policy": {
      "architecture-decisions": "indefinite",
      "incident-reports": "3-years",
      "security-vulnerabilities": "indefinite",
      "design-proposals": "5-years"
    }
  },
  "governance_rules": [
    {
      "id": "gov-eng-001",
      "name": "Code Review & Security Gates",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "change_type": "production-code",
        "requirement": "minimum-2-approvals"
      },
      "actions": ["mandatory-security-scan", "mandatory-code-review", "block-merge-if-failures"]
    },
    {
      "id": "gov-eng-002",
      "name": "Incident Record Integrity",
      "type": "audit",
      "enforcement": "enforce",
      "conditions": {
        "record_type": "incident-report",
        "severity": "p1-or-p2"
      },
      "actions": ["immutable-records", "legal-hold-enabled", "no-deletion"]
    },
    {
      "id": "gov-eng-003",
      "name": "Security Vulnerability Tracking",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "vulnerability_severity": "critical-or-high",
        "sla_requirement": true
      },
      "actions": ["track-to-remediation", "escalate-if-sla-breach", "security-team-approval-required"]
    }
  ],
  "kpis": [
    {
      "id": "eng-kpi-001",
      "name": "Deployment Frequency",
      "description": "Number of production deployments per week",
      "metric_type": "counter",
      "unit": "per-week",
      "thresholds": {"target": 10, "warning": 5, "critical": 2},
      "aggregation_period": "week"
    },
    {
      "id": "eng-kpi-002",
      "name": "Lead Time for Changes",
      "description": "Average time from code commit to production deployment",
      "metric_type": "gauge",
      "unit": "hours",
      "thresholds": {"target": 1, "warning": 24, "critical": 72},
      "aggregation_period": "week"
    },
    {
      "id": "eng-kpi-003",
      "name": "Change Failure Rate",
      "description": "Percentage of deployments causing incidents",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 5, "warning": 10, "critical": 20},
      "aggregation_period": "month"
    },
    {
      "id": "eng-kpi-004",
      "name": "Mean Time to Recovery (MTTR)",
      "description": "Average time to recover from production incidents",
      "metric_type": "gauge",
      "unit": "minutes",
      "thresholds": {"target": 30, "warning": 60, "critical": 120},
      "aggregation_period": "month"
    },
    {
      "id": "eng-kpi-005",
      "name": "System Uptime / Reliability",
      "description": "Percentage of time systems are operational",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 99.99, "warning": 99.9, "critical": 99.5},
      "aggregation_period": "month"
    },
    {
      "id": "eng-kpi-006",
      "name": "Security Vulnerability Resolution",
      "description": "Percentage of vulnerabilities resolved within SLA",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 100, "warning": 90, "critical": 75},
      "aggregation_period": "month"
    },
    {
      "id": "eng-kpi-007",
      "name": "Technical Debt Ratio",
      "description": "Percentage of engineering capacity spent on technical debt",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {"target": 15, "warning": 25, "critical": 35},
      "aggregation_period": "quarter"
    }
  ],
