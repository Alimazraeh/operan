  "operational_policies": [
    {
      "id": "pol-eng-001",
      "name": "Agent Autonomy in Engineering",
      "scope": "agent",
      "rules": [
        {"agent": "eng-gpo-pod-01", "allowed": ["documentation", "scheduling", "reporting", "project-tracking"], "denied": ["make-technical-decisions", "merge-code", "approve-architecture", "respond-to-incidents"]},
        {"requirement": "all-code-changes-require-human-code-review-and-approval"}
      ]
    },
    {
      "id": "pol-eng-002",
      "name": "Data Retention for Engineering Records",
      "scope": "system",
      "rules": [
        {"data_type": "architecture-decisions", "retention": "indefinite", "disposal": "none"},
        {"data_type": "incident-reports", "retention": "3-years", "disposal": "secure-delete"},
        {"data_type": "security-vulnerabilities", "retention": "indefinite", "disposal": "none"}
      ]
