  "workflows": [
    {
      "id": "wf-campaign-001",
      "name": "Enterprise Campaign Management",
      "description": "Multi-channel enterprise campaign from strategy through measurement.",
      "triggers": [
        "manual",
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "campaign-01",
          "type": "agent_call",
          "name": "Campaign Strategy",
          "config": {
            "agent": "demand-gen-lead-01",
            "task": "Define multi-channel strategy, target segments, budget allocation, and KPIs"
          }
        },
        {
          "id": "campaign-02",
          "type": "agent_call",
          "name": "Content & Creative",
          "config": {
            "agent": "content-strategy-lead-01",
            "task": "Develop content strategy and creative briefs for multi-market deployment"
          }
        },
        {
          "id": "campaign-03",
          "type": "agent_call",
          "name": "Brand Review",
          "config": {
            "agent": "brand-director-01",
            "task": "Review creative for brand alignment across markets"
          }
        },
        {
          "id": "campaign-04",
          "type": "tool_call",
          "name": "Deploy to Channels",
          "config": {
            "tool": "marketing-automation",
            "action": "deploy-multi-channel"
          }
        },
        {
          "id": "campaign-05",
          "type": "transformation",
          "name": "Optimize & Report",
          "config": {
            "agent": "marketing-analytics-lead-01",
            "task": "Monitor performance, optimize, generate insights"
          }
        }
      ]
    },
    {
      "id": "wf-launch-001",
      "name": "Product Launch Process",
      "description": "End-to-end enterprise product launch with cross-functional coordination.",
      "triggers": [
        "schedule:product-calendar"
      ],
      "steps": [
        {
          "id": "launch-01",
          "type": "agent_call",
          "name": "Launch Planning",
          "config": {
            "agent": "product-marketing-lead-01",
            "task": "Create launch plan, coordinate with sales, product, and marketing teams"
          }
        },
        {
          "id": "launch-02",
          "type": "transformation",
          "name": "Create Launch Assets",
          "config": {
            "agent": "content-strategy-lead-01",
            "task": "Develop all launch content: PR, web, sales enablement, social"
          }
        },
        {
          "id": "launch-03",
          "type": "tool_call",
          "name": "Execute Launch",
          "config": {
            "tool": "marketing-automation",
            "action": "coordinate-launch-activities"
          }
        },
        {
          "id": "launch-04",
          "type": "transformation",
          "name": "Post-Launch Analysis",
          "config": {
            "agent": "marketing-analytics-lead-01",
            "task": "Analyze launch performance, document learnings"
          }
        }
      ]
    },
    {
      "id": "wf-analytics-001",
      "name": "Marketing Performance & ROI",
      "description": "Comprehensive marketing analytics: attribution, ROI, and strategic recommendations.",
      "triggers": [
        "schedule:monthly",
        "schedule:quarterly"
      ],
      "steps": [
        {
          "id": "analytics-01",
          "type": "agent_call",
          "name": "Data Collection",
          "config": {
            "agent": "marketing-ops-lead-01",
            "task": "Collect data from all marketing channels and systems"
          }
        },
        {
          "id": "analytics-02",
          "type": "transformation",
          "name": "Attribution Analysis",
          "config": {
            "agent": "marketing-analytics-lead-01",
            "task": "Run attribution models, calculate ROI, identify top-performing channels"
          }
        },
        {
          "id": "analytics-03",
          "type": "agent_call",
          "name": "Strategic Recommendations",
          "config": {
            "agent": "cmo-01",
            "task": "Review analytics, recommend budget reallocation and strategy adjustments"
          }
        }
      ]
    }
  ],
