  "governance_rules": [
    {
      "id": "gov-mkt-l-001",
      "name": "Brand Governance",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "asset_type": "public-facing"
      },
      "actions": [
        "require-brand-approval",
        "enforce-guidelines",
        "log-all-usage"
      ]
    },
    {
      "id": "gov-mkt-l-002",
      "name": "Data Privacy & Compliance",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "data_type": "personal-data"
      },
      "actions": [
        "gdpr-compliant",
        "ccpa-compliant",
        "consent-management",
        "data-minimization"
      ]
    },
    {
      "id": "gov-mkt-l-003",
      "name": "Budget Approval",
      "type": "compliance",
      "enforcement": "enforce",
      "conditions": {
        "budget_above": "threshold"
      },
      "actions": [
        "require-cmo-approval",
        "document-roi",
        "track-spend"
      ]
    }
  ],
  "kpis": [
    {
      "id": "mkt-kpi-l-001",
      "name": "Marketing-Sourced Pipeline",
      "description": "Total pipeline generated by marketing activities",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 10000000,
        "warning": 7500000,
        "critical": 5000000
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "mkt-kpi-l-002",
      "name": "Marketing ROI",
      "description": "Return on marketing investment",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 400,
        "warning": 300,
        "critical": 200
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "mkt-kpi-l-003",
      "name": "Cost Per Acquisition (CPA)",
      "description": "Average cost to acquire a customer",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 150,
        "warning": 200,
        "critical": 250
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "mkt-kpi-l-004",
      "name": "Brand Awareness Score",
      "description": "Measured brand awareness in target markets",
      "metric_type": "gauge",
      "unit": "score",
      "thresholds": {
        "target": 85,
        "warning": 75,
        "critical": 60
      },
      "aggregation_period": "year"
    },
    {
      "id": "mkt-kpi-l-005",
      "name": "Customer Lifetime Value (LTV)",
      "description": "Average customer lifetime value",
      "metric_type": "gauge",
      "unit": "currency",
      "thresholds": {
        "target": 15000,
        "warning": 12000,
        "critical": 8000
      },
      "aggregation_period": "quarter"
    },
    {
      "id": "mkt-kpi-l-006",
      "name": "Channel Performance",
      "description": "Lead conversion rate by channel",
      "metric_type": "gauge",
      "unit": "percent",
      "thresholds": {
        "target": 15,
        "warning": 10,
        "critical": 5
      },
      "aggregation_period": "month"
    }
  ],
